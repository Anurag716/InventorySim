        // RENDER SALES CHARTS
        // =========================================================

        function renderSalesCharts(sales) {

            const barColumn = document.getElementById("barChartColumn");
            const pieColumn = document.getElementById("pieChartColumn");
            if (barColumn) barColumn.className = "col-lg-6";
            if (pieColumn) {
                pieColumn.className = "col-lg-6";
                pieColumn.style.display = "";
            }

            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");

            if (!barContainer || !pieContainer) {
                return;
            }

            destroyCharts();

            if (!sales || sales.length === 0) {

                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-bar-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">No sales data</div>
                        <small>No sales found for the selected period.</small>
                    </div>`;

                pieContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-pie-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">No payment data</div>
                        <small>No sales found for the selected period.</small>
                    </div>`;

                return;
            }

            // ---------------------------------------------------------
            // Chart containers
            // ---------------------------------------------------------

            barContainer.innerHTML = `
                <div class="report-chart-header">
                    <div class="report-chart-title">Sales Overview</div>
                    <div class="report-chart-subtitle">Sales amount by date</div>
                </div>

                <div class="report-chart-canvas">
                    <canvas id="salesBarChart"></canvas>
                </div>`;

            pieContainer.innerHTML = `
                <div class="report-chart-header">
                    <div class="report-chart-title">Payment Distribution</div>
                    <div class="report-chart-subtitle">Sales amount by payment method</div>
                </div>

                <div class="report-chart-canvas">
                    <canvas id="salesPieChart"></canvas>
                </div>`;


            // ---------------------------------------------------------
            // SALES BY DATE
            // ---------------------------------------------------------

            const salesByDate = {};

            sales.forEach(sale => {

                if (!sale.date) {
                    return;
                }

                const date = new Date(sale.date);

                if (isNaN(date)) {
                    return;
                }

                const dateKey = date.toLocaleDateString("en-IN", {
                    day: "2-digit",
                    month: "short"
                });

                if (!salesByDate[dateKey]) {
                    salesByDate[dateKey] = 0;
                }

                salesByDate[dateKey] += Number(sale.grandTotal || 0);
            });

            const barLabels = Object.keys(salesByDate);
            const barValues = Object.values(salesByDate);


            // ---------------------------------------------------------
            // BAR CHART COLORS
            // ---------------------------------------------------------

            const barColorPalette = [
                {
                    start: "#4f9cff",
                    middle: "#0d6efd",
                    end: "#084298",
                    hoverStart: "#7ab8ff",
                    hoverMiddle: "#0d6efd",
                    hoverEnd: "#052c65"
                },
                {
                    start: "#48e0b0",
                    middle: "#20c997",
                    end: "#087f5b",
                    hoverStart: "#78edca",
                    hoverMiddle: "#20c997",
                    hoverEnd: "#056047"
                },
                {
                    start: "#ffe083",
                    middle: "#ffc107",
                    end: "#b58100",
                    hoverStart: "#ffeaad",
                    hoverMiddle: "#ffc107",
                    hoverEnd: "#8f6900"
                },
                {
                    start: "#a77bff",
                    middle: "#6f42c1",
                    end: "#43217a",
                    hoverStart: "#c5a7ff",
                    hoverMiddle: "#6f42c1",
                    hoverEnd: "#351861"
                },
                {
                    start: "#ffae69",
                    middle: "#fd7e14",
                    end: "#b84d00",
                    hoverStart: "#ffc895",
                    hoverMiddle: "#fd7e14",
                    hoverEnd: "#963e00"
                },
                {
                    start: "#ff7180",
                    middle: "#dc3545",
                    end: "#9b1c29",
                    hoverStart: "#ff9aa4",
                    hoverMiddle: "#dc3545",
                    hoverEnd: "#7f1722"
                }
            ];


            // ---------------------------------------------------------
            // BAR CHART
            // ---------------------------------------------------------

            const barCanvas = document.getElementById("salesBarChart");

            if (barCanvas && barLabels.length > 0) {

                const barContext = barCanvas.getContext("2d");

                const barGradients = barLabels.map((_, index) => {

                    const palette =
                        barColorPalette[index % barColorPalette.length];

                    const gradient =
                        barContext.createLinearGradient(0, 0, 0, 330);

                    gradient.addColorStop(0, palette.start);
                    gradient.addColorStop(0.5, palette.middle);
                    gradient.addColorStop(1, palette.end);

                    return gradient;
                });

                const hoverBarGradients = barLabels.map((_, index) => {

                    const palette =
                        barColorPalette[index % barColorPalette.length];

                    const gradient =
                        barContext.createLinearGradient(0, 0, 0, 330);

                    gradient.addColorStop(0, palette.hoverStart);
                    gradient.addColorStop(0.45, palette.hoverMiddle);
                    gradient.addColorStop(1, palette.hoverEnd);

                    return gradient;
                });

                salesBarChart = new Chart(barCanvas, {
                    type: "bar",
                    data: {
                        labels: barLabels,
                        datasets: [{
                            label: "Sales",
                            data: barValues,
                            backgroundColor: barGradients,
                            hoverBackgroundColor: hoverBarGradients,
                            borderWidth: 0,
                            borderRadius: 10,
                            borderSkipped: false,
                            barPercentage: 0.62,
                            categoryPercentage: 0.72,
                            hoverBorderWidth: 2,
                            hoverBorderColor: "#ffffff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: true,
                            mode: "nearest"
                        },
                        animation: {
                            duration: 700,
                            easing: "easeOutQuart"
                        },
                        hover: {
                            mode: "nearest",
                            intersect: true,
                            animationDuration: 250
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: "rgba(18, 24, 38, 0.96)",
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                padding: 13,
                                cornerRadius: 10,
                                displayColors: false,
                                titleFont: {
                                    size: 12,
                                    weight: "600"
                                },
                                bodyFont: {
                                    size: 13,
                                    weight: "500"
                                },
                                callbacks: {
                                    label: function (context) {
                                        return " ₹" + Number(context.raw || 0).toLocaleString(
                                            "en-IN",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        );
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                border: {
                                    display: false
                                },
                                ticks: {
                                    color: "#6c757d",
                                    font: {
                                        size: 11
                                    }
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: "rgba(0, 0, 0, 0.055)",
                                    drawTicks: false
                                },
                                border: {
                                    display: false
                                },
                                ticks: {
                                    color: "#6c757d",
                                    padding: 10,
                                    font: {
                                        size: 11
                                    },
                                    callback: function (value) {
                                        if (value >= 100000) {
                                            return "₹" + (value / 100000).toFixed(1) + "L";
                                        }

                                        if (value >= 1000) {
                                            return "₹" + (value / 1000).toFixed(0) + "K";
                                        }

                                        return "₹" + value;
                                    }
                                }
                            }
                        }
                    }
                });
            }


            // ---------------------------------------------------------
            // PAYMENT METHOD DISTRIBUTION
            // ---------------------------------------------------------

            const paymentTotals = {};

            sales.forEach(sale => {

                const method = sale.paymentMethod || "Unknown";

                if (!paymentTotals[method]) {
                    paymentTotals[method] = 0;
                }

                paymentTotals[method] += Number(sale.grandTotal || 0);
            });

            const pieLabels = Object.keys(paymentTotals);
            const pieValues = Object.values(paymentTotals);

            const totalSales = pieValues.reduce(
                (total, value) => total + Number(value || 0),
                0
            );

            const paymentColors = [
                "#0d6efd",
                "#20c997",
                "#ffc107",
                "#dc3545",
                "#6f42c1",
                "#fd7e14"
            ];

            const paymentHoverColors = [
                "#4094ff",
                "#39d8aa",
                "#ffd34d",
                "#e4606d",
                "#8558d4",
                "#ff9b4a"
            ];

            const pieCanvas = document.getElementById("salesPieChart");

            if (pieCanvas && pieLabels.length > 0) {

                salesPieChart = new Chart(pieCanvas, {
                    type: "doughnut",
                    data: {
                        labels: pieLabels,
                        datasets: [{
                            data: pieValues,
                            backgroundColor: pieLabels.map(
                                (_, index) => paymentColors[index % paymentColors.length]
                            ),
                            hoverBackgroundColor: pieLabels.map(
                                (_, index) => paymentHoverColors[index % paymentHoverColors.length]
                            ),
                            borderColor: "#ffffff",
                            borderWidth: 4,
                            hoverBorderColor: "#ffffff",
                            hoverBorderWidth: 5,
                            hoverOffset: 16
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "66%",
                        animation: {
                            animateRotate: true,
                            animateScale: true,
                            duration: 900,
                            easing: "easeOutQuart"
                        },
                        interaction: {
                            intersect: true,
                            mode: "nearest"
                        },
                        hover: {
                            mode: "nearest",
                            intersect: true,
                            animationDuration: 250
                        },
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: {
                                    usePointStyle: true,
                                    pointStyle: "circle",
                                    padding: 18,
                                    color: "#495057",
                                    font: {
                                        size: 12,
                                        weight: "500"
                                    }
                                }
                            },
                            tooltip: {
                                backgroundColor: "rgba(18, 24, 38, 0.96)",
                                titleColor: "#ffffff",
                                bodyColor: "#ffffff",
                                padding: 13,
                                cornerRadius: 10,
                                callbacks: {
                                    label: function (context) {

                                        const value = Number(context.raw || 0);
                                        const percentage = totalSales > 0
                                            ? (value / totalSales) * 100
                                            : 0;

                                        return " ₹" + value.toLocaleString(
                                            "en-IN",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        ) + "  •  " + percentage.toFixed(1) + "%";
                                    }
                                }
                            }
                        }
                    },
                    plugins: [{
                        id: "centerText",
                        beforeDraw: function (chart) {

                            const ctx = chart.ctx;

                            const centerX =
                                (chart.chartArea.left + chart.chartArea.right) / 2;

                            const centerY =
                                (chart.chartArea.top + chart.chartArea.bottom) / 2;

                            ctx.save();

                            ctx.font = "600 19px Arial";
                            ctx.fillStyle = "#212529";
                            ctx.textAlign = "center";
                            ctx.textBaseline = "middle";

                            ctx.fillText(
                                "₹" + totalSales.toLocaleString(
                                    "en-IN",
                                    {
                                        maximumFractionDigits: 0
                                    }
                                ),
                                centerX,
                                centerY - 9
                            );

                            ctx.font = "12px Arial";
                            ctx.fillStyle = "#6c757d";

                            ctx.fillText(
                                "Total Sales",
                                centerX,
                                centerY + 16
                            );

                            ctx.restore();
                        }
                    }]
                });
            }
        }



      // =========================================================
// EXPORT CURRENT REPORT TO EXCEL
// =========================================================

function exportCurrentReport() {

    const reportType =
        document.getElementById("reportType")?.value || "Sales";

    const fromDate =
        document.getElementById("fromDate")?.value || "";

    const toDate =
        document.getElementById("toDate")?.value || "";


    const params = new URLSearchParams();

    params.append("reportType", reportType);

    if (fromDate) {
        params.append("fromDate", fromDate);
    }

    if (toDate) {
        params.append("toDate", toDate);
    }


    window.location.href =
        `/Reports/ExportExcel?${params.toString()}`;

}

        // =========================================================
        // CURRENCY FORMATTER
        // =========================================================

        function formatCurrency(value) {

            return "₹" + Number(value || 0).toLocaleString(
                "en-IN",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
        }
