            <td>${formatCurrency(item.subtotal)}</td>
            <td>${formatCurrency(item.discount)}</td>
            <td>${formatCurrency(item.tax)}</td>
            <td class="fw-bold">${formatCurrency(item.grandTotal)}</td>
        </tr>
    `).join("");
}

