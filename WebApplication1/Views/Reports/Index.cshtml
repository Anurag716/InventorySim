// =========================================================
// RENDER INVENTORY TABLE
// =========================================================

function renderInventoryTable(inventory) {

    const tableHead = document.getElementById("reportTableHead");
    const tableBody = document.getElementById("reportTableBody");

    if (!tableHead || !tableBody) return;

    if (!inventory || inventory.length === 0) {

        tableHead.innerHTML = `
            <tr>
                <th>No data</th>
            </tr>`;

        tableBody.innerHTML = `
            <tr>
                <td class="text-center text-muted py-4">
                    No active products found in inventory.
                </td>
            </tr>`;

        return;
    }

    tableHead.innerHTML = `
        <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Current Stock</th>
            <th>Reorder Level</th>
            <th>Status</th>
        </tr>`;

    tableBody.innerHTML = inventory.map(product => {

        const status = product.status || "Unknown";

        let statusClass = "bg-secondary";

        if (status === "In Stock") {
            statusClass = "bg-success";
        }
        else if (status === "Low Stock") {
            statusClass = "bg-warning text-dark";
        }
        else if (status === "Out of Stock") {
            statusClass = "bg-danger";
        }

        return `
            <tr>
                <td class="fw-semibold">
                    ${escapeHtml(product.productName || "-")}
                </td>

                <td>
                    ${escapeHtml(product.sku || "-")}
                </td>

                <td>
                    ${Number(product.currentStock || 0).toLocaleString("en-IN")}
                </td>

                <td>
                    ${Number(product.reorderLevel || 0).toLocaleString("en-IN")}
                </td>

                <td>
                    <span class="badge ${statusClass}">
                        ${escapeHtml(status)}
                    </span>
                </td>
            </tr>`;
    }).join("");
}

// =========================================================
// RENDER INVENTORY CHARTS
// =========================================================

function renderInventoryCharts(inventory) {

    const barColumn = document.getElementById("barChartColumn");
    const pieColumn = document.getElementById("pieChartColumn");
    const barContainer = document.getElementById("barChartContainer");
    const pieContainer = document.getElementById("pieChartContainer");

    if (!barColumn || !pieColumn || !barContainer || !pieContainer) {
        return;
    }

    destroyCharts();

    barColumn.className = "col-lg-7";
    pieColumn.className = "col-lg-5";
    pieColumn.style.display = "";

    if (!inventory || inventory.length === 0) {

        barContainer.innerHTML = `
            <div class="report-empty-state">
                <i class="bi bi-box-seam fs-1 mb-2"></i>
                <div class="fw-semibold">No inventory data</div>
                <small>No active products found.</small>
            </div>`;

        pieContainer.innerHTML = `
            <div class="report-empty-state">
                <i class="bi bi-pie-chart fs-1 mb-2"></i>
                <div class="fw-semibold">No inventory status</div>
                <small>No active products found.</small>
            </div>`;

        return;
    }

    // =========================================================
    // CHART CONTAINERS
    // =========================================================

    barContainer.innerHTML = `
        <div class="report-chart-header">
            <div class="report-chart-title">
                Current Stock by Product
            </div>

            <div class="report-chart-subtitle">
                Current available units
            </div>
        </div>

        <div class="report-chart-canvas">
            <canvas id="inventoryStockChart"></canvas>
        </div>`;

    pieContainer.innerHTML = `
        <div class="report-chart-header">
            <div class="report-chart-title">
                Inventory Status
            </div>

            <div class="report-chart-subtitle">
                Products by stock condition
            </div>
        </div>

        <div class="report-chart-canvas">
            <canvas id="inventoryStatusChart"></canvas>
        </div>`;


    // =========================================================
    // CHART 1: CURRENT STOCK BY PRODUCT
    // =========================================================

    const chartProducts = inventory.slice(0, 10);

    const stockLabels = chartProducts.map(
        product => product.productName || "Unknown Product"
    );

    const stockValues = chartProducts.map(
        product => Number(product.currentStock || 0)
    );

    const stockCanvas = document.getElementById("inventoryStockChart");

    if (stockCanvas) {

        inventoryStockChart = new Chart(stockCanvas, {

            type: "bar",

            data: {
                labels: stockLabels,

                datasets: [{
                    label: "Current Stock",
                    data: stockValues,

                    backgroundColor: "rgba(13, 110, 253, 0.78)",
                    hoverBackgroundColor: "rgba(8, 66, 152, 0.92)",

                    borderWidth: 0,
                    borderRadius: 8,
                    borderSkipped: false,

                    barPercentage: 0.65,
                    categoryPercentage: 0.72
                }]
            },

            options: {

                indexAxis: "y",

                responsive: true,

                maintainAspectRatio: false,
                animation: {
                    duration: 2000,
                    easing: "easeOutQuart"
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        backgroundColor: "rgba(18, 24, 38, 0.96)",

                        titleColor: "#ffffff",
                        bodyColor: "#ffffff",

                        padding: 13,

                        cornerRadius: 10,

                        displayColors: false,

                        callbacks: {

                            label: function (context) {

                                return " " +
                                    Number(context.raw || 0)
                                        .toLocaleString("en-IN") +
                                    " unit(s)";
                            }
                        }
                    }
                },

                scales: {

                    x: {

                        beginAtZero: true,

                        grid: {
                            color: "rgba(0, 0, 0, 0.055)",
                            drawTicks: false
                        },

                        border: {
                            display: false
                        },

                        ticks: {
                            color: "#6c757d",
                            padding: 8,
                            precision: 0
                        }
                    },

                    y: {

                        grid: {
                            display: false
                        },

                        border: {
                            display: false
                        },

                        ticks: {
                            color: "#495057",
                            padding: 8,

                            font: {
                                size: 11,
                                weight: "500"
                            }
                        }
                    }
                }
            }
        });
    }


    // =========================================================
    // CHART 2: INVENTORY STATUS DISTRIBUTION
    // =========================================================

    const statusTotals = {
        "In Stock": 0,
        "Low Stock": 0,
        "Out of Stock": 0
    };

    inventory.forEach(product => {

        const status = product.status || "Out of Stock";

        if (statusTotals.hasOwnProperty(status)) {
            statusTotals[status]++;
        }
    });

    const statusLabels = Object.keys(statusTotals);

    const statusValues = Object.values(statusTotals);

    const totalProducts = statusValues.reduce(
        (total, value) => total + value,
        0
    );

    const statusColors = [
        "#198754",
        "#ffc107",
        "#dc3545"
    ];

    const statusHoverColors = [
        "#157347",
        "#ffca2c",
        "#bb2d3b"
    ];

    const statusCanvas =
        document.getElementById("inventoryStatusChart");

    if (statusCanvas) {

        inventoryStatusChart = new Chart(statusCanvas, {

            type: "doughnut",

            data: {

                labels: statusLabels,

                datasets: [{

                    data: statusValues,

                    backgroundColor: statusColors,

                    hoverBackgroundColor: statusHoverColors,

                    borderColor: "#ffffff",

                    borderWidth: 4,

                    hoverBorderColor: "#ffffff",

                    hoverBorderWidth: 5,

                    hoverOffset: 12
                }]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: "66%",

                animation: {

                    animateRotate: true,

                    animateScale: true,

                    duration: 2000,

                    easing: "easeOutQuart"
                },

                plugins: {

                    legend: {

                        position: "bottom",

                        labels: {

                            usePointStyle: true,

                            pointStyle: "circle",

                            padding: 18,

                            color: "#495057",

                            font: {
                                size: 12,
                                weight: "500"
                            }
                        }
                    },

                    tooltip: {

                        backgroundColor: "rgba(18, 24, 38, 0.96)",

                        titleColor: "#ffffff",

                        bodyColor: "#ffffff",

                        padding: 13,

                        cornerRadius: 10,

                        callbacks: {

                            label: function (context) {

                                const value =
                                    Number(context.raw || 0);

                                const percentage =
                                    totalProducts > 0
                                        ? (value / totalProducts) * 100
                                        : 0;

                                return " " +
                                    value +
                                    " product(s) • " +
                                    percentage.toFixed(1) +
                                    "%";
                            }
                        }
                    }
                }
            },

            plugins: [{

                id: "inventoryCenterText",

                beforeDraw: function (chart) {

                    const ctx = chart.ctx;

                    const centerX =
                        (chart.chartArea.left +
                         chart.chartArea.right) / 2;

                    const centerY =
                        (chart.chartArea.top +
                         chart.chartArea.bottom) / 2;

                    ctx.save();

                    ctx.font = "600 19px Arial";

                    ctx.fillStyle = "#212529";

                    ctx.textAlign = "center";

                    ctx.textBaseline = "middle";

                    ctx.fillText(
                        totalProducts.toLocaleString("en-IN"),
                        centerX,
                        centerY - 9
                    );

                    ctx.font = "12px Arial";

                    ctx.fillStyle = "#6c757d";

                    ctx.fillText(
                        "Products",
                        centerX,
                        centerY + 16
                    );

                    ctx.restore();
                }
            }]
        });
    }
}

        // =========================================================
        // HTML ESCAPE HELPER
        // Prevents report data from being inserted as raw HTML.
        // =========================================================

        function escapeHtml(value) {

            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}
