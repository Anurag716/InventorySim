@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1">Reports</h2>
        <p class="text-muted mb-0">
            Analyze sales, products, returns, customers, income and inventory.
        </p>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label for="fromDate" class="form-label">From Date</label>
                    <input type="date"
                           id="fromDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label for="toDate" class="form-label">To Date</label>
                    <input type="date"
                           id="toDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label for="reportType" class="form-label">Report</label>
                    <select id="reportType" class="form-select">
                        <option value="Sales">Sales</option>
                        <option value="Products">Products</option>
                        <option value="Returns">Returns</option>
                        <option value="Customers">Customers</option>
                        <option value="Income">Income</option>
                        <option value="Inventory">Inventory</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="button"
                            id="exportReportBtn"
                            class="btn btn-outline-success w-100">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                        Export XLSX
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">

        <div id="barChartColumn" class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div id="barChartContainer" class="report-chart-container">
                        <div class="report-empty-state">
                            <i class="bi bi-bar-chart fs-1 mb-2"></i>
                            <div class="fw-semibold">Report chart will appear here.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="pieChartColumn" class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div id="pieChartContainer" class="report-chart-container">
                        <div class="report-empty-state">
                            <i class="bi bi-pie-chart fs-1 mb-2"></i>
                            <div class="fw-semibold">Report chart will appear here.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Report Data -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Report Data</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead id="reportTableHead">
                        <tr>
                            <th>No data</th>
                        </tr>
                    </thead>
                    <tbody id="reportTableBody">
                        <tr>
                            <td class="text-center text-muted py-4">
                                Report data will appear here.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<style>
    /* =========================================
       REPORT CHART CONTAINERS
       ========================================= */

    .report-chart-container {
        position: relative;
        width: 100%;
        height: 400px;
        padding: 0;
        transition: transform 0.25s ease, filter 0.25s ease;
    }

    .report-chart-container:hover {
        transform: translateY(-2px);
        filter: drop-shadow(0 8px 18px rgba(13, 110, 253, 0.08));
    }

    /* =========================================
       CHART HEADER
       ========================================= */

    .report-chart-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
        padding: 0 10px;
        pointer-events: none;
    }

    .report-chart-title {
        font-size: 16px;
        font-weight: 600;
        color: #212529;
        margin: 0;
    }

    .report-chart-subtitle {
        font-size: 12px;
        color: #6c757d;
        margin-top: 3px;
    }

    /* =========================================
       CANVAS AREA
       ========================================= */

    .report-chart-canvas {
        position: absolute;
        top: 48px;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: calc(100% - 48px);
    }

    .report-chart-canvas canvas {
        width: 100% !important;
        height: 100% !important;
    }

    /* =========================================
       EMPTY / LOADING STATE
       ========================================= */

    .report-empty-state {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #6c757d;
    }

    .report-empty-state i {
        opacity: 0.65;
    }

    /* =========================================
       TABLE
       ========================================= */

    #reportTableHead th {
        white-space: nowrap;
        font-size: 0.875rem;
    }

    #reportTableBody td {
        white-space: nowrap;
        font-size: 0.875rem;
    }

    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 992px) {
        .report-chart-container {
            height: 350px;
        }

        .report-chart-canvas {
            top: 45px;
            height: calc(100% - 45px);
        }
    }

    @@media (max-width: 576px) {
        .report-chart-container {
            height: 320px;
        }

        .report-chart-header {
            padding: 0 5px;
        }

        .report-chart-title {
            font-size: 15px;
        }

        .report-chart-subtitle {
            font-size: 11px;
        }

        .report-chart-canvas {
            top: 43px;
            height: calc(100% - 43px);
        }
    }
</style>

@section Scripts {

    <!-- Chart.js must load before the report JavaScript uses Chart. -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // =========================================================
        // GLOBAL STATE
        // =========================================================

        let salesBarChart = null;
        let salesPieChart = null;
        let productsBarChart = null;
        let returnsBarChart = null;
        let returnsLineChart = null;
        let customersSpendingChart = null;
        let incomeLineChart = null;
        let incomeBreakdownChart = null;
        let customersPurchasesChart = null;
        let inventoryStockChart = null;
        let inventoryStatusChart = null;
        let currentReportData = [];
        let currentReportType = "Sales";


        // =========================================================
        // PAGE INITIALIZATION
        // =========================================================

        document.addEventListener("DOMContentLoaded", function () {

            const fromDate = document.getElementById("fromDate");
            const toDate = document.getElementById("toDate");
            const reportType = document.getElementById("reportType");
            const exportButton = document.getElementById("exportReportBtn");

            if (fromDate) {
                fromDate.addEventListener("change", loadReport);
            }

            if (toDate) {
                toDate.addEventListener("change", loadReport);
            }

            if (reportType) {
                reportType.addEventListener("change", loadReport);
            }

            if (exportButton) {
                exportButton.addEventListener("click", exportCurrentReport);
            }

            loadReport();
        });


        // =========================================================
        // LOAD REPORT
        // =========================================================

        async function loadReport() {

            const reportTypeElement = document.getElementById("reportType");
            const fromDateElement = document.getElementById("fromDate");
            const toDateElement = document.getElementById("toDate");

            const reportType = reportTypeElement?.value || "Sales";
            const fromDate = fromDateElement?.value || "";
            const toDate = toDateElement?.value || "";

            currentReportType = reportType;
            currentReportData = [];

            // Prevent an invalid date range from making a request.
            if (fromDate && toDate && fromDate > toDate) {
                clearReportDisplay();
                renderMessage(
                    "Invalid date range",
                    "From Date cannot be later than To Date."
                );
                return;
            }

            showLoadingState();

            const params = new URLSearchParams();

            if (fromDate) params.append("fromDate", fromDate);
            if (toDate) params.append("toDate", toDate);

            const endpointMap = {
                Sales: "/Reports/GetSalesReport",
                Products: "/Reports/GetProductsReport",
                Returns: "/Reports/GetReturnsReport",
                Customers: "/Reports/GetCustomersReport",
                Income: "/Reports/GetIncomeReport",
                Inventory: "/Reports/GetInventoryReport"

            };

            const endpoint = endpointMap[reportType];

            if (!endpoint) {
                clearReportDisplay();
                renderMessage(
                    `${reportType} report is not implemented yet`,
                    "The report structure is ready. This report type will be connected to its backend endpoint next."
                );
                return;
            }

            try {
                const response = await fetch(
                    `${endpoint}?${params.toString()}`,
                    {
                        method: "GET",
                        headers: { "Accept": "application/json" }
                    }
                );

                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const result = await response.json();

                if (!result.success) {
                    throw new Error("The server returned an unsuccessful response.");
                }

                currentReportData = Array.isArray(result.data) ? result.data : [];

                if (reportType === "Sales") {
                    renderSalesTable(currentReportData);
                    renderSalesCharts(currentReportData);
                } else if (reportType === "Products") {
                    renderProductsTable(currentReportData);
                    renderProductsChart(currentReportData);
                } else if (reportType === "Returns") {
                    renderReturnsTable(currentReportData);
                    renderReturnsCharts(currentReportData);
                } else if (reportType === "Customers") {
                    renderCustomersTable(currentReportData);
                    renderCustomersCharts(currentReportData);
                } else if (reportType === "Income") {
                    renderIncomeTable(currentReportData);
                    renderIncomeChart(currentReportData);
                }else if (reportType === "Inventory") {
                    renderInventoryTable(currentReportData);
                    renderInventoryCharts(currentReportData);
                }
            }
            catch (error) {
                console.error(`Error loading ${reportType.toLowerCase()} report:`, error);
                currentReportData = [];
                clearReportDisplay();
                renderMessage(
                    "Unable to load report",
                    `Something went wrong while loading the ${reportType.toLowerCase()} report. Check the browser console and server endpoint.`
                );
            }
        }

        // =========================================================
        // RENDER GENERAL MESSAGE
        // =========================================================

        function renderMessage(title, message) {

            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");

            if (barContainer) {
                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-bar-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">${escapeHtml(title)}</div>
                        <small>${escapeHtml(message)}</small>
                    </div>`;
            }

            if (pieContainer) {
                pieContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-pie-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">${escapeHtml(title)}</div>
                        <small>${escapeHtml(message)}</small>
                    </div>`;
            }

            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (tableHead) {
                tableHead.innerHTML = `<tr><th>No data</th></tr>`;
            }

            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            ${escapeHtml(message)}
                        </td>
                    </tr>`;
            }
        }


        // =========================================================
        // LOADING STATE
        // =========================================================

        function showLoadingState() {

            destroyCharts();

            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");

            if (barContainer) {
                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <div class="fw-semibold">Loading report...</div>
                    </div>`;
            }

            if (pieContainer) {
                pieContainer.innerHTML = `
                    <div class="report-empty-state">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <div class="fw-semibold">Loading chart...</div>
                    </div>`;
            }

            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (tableHead) {
                tableHead.innerHTML = `<tr><th>Loading...</th></tr>`;
            }

            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            Loading report data...
                        </td>
                    </tr>`;
            }
        }


        // =========================================================
        // CLEAR REPORT DISPLAY
        // =========================================================

        function clearReportDisplay() {

            const barColumn = document.getElementById("barChartColumn");
            const pieColumn = document.getElementById("pieChartColumn");

            if (barColumn) barColumn.className = "col-lg-6";
            if (pieColumn) {
                pieColumn.className = "col-lg-6";
                pieColumn.style.display = "";
            }

            destroyCharts();

            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");
            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (barContainer) {
                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-bar-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">No chart data</div>
                    </div>`;
            }

            if (pieContainer) {
                pieContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-pie-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">No chart data</div>
                    </div>`;
            }

            if (tableHead) {
                tableHead.innerHTML = `<tr><th>No data</th></tr>`;
            }

            if (tableBody) {
                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            No report data available.
                        </td>
                    </tr>`;
            }
        }


        // =========================================================
        // DESTROY EXISTING CHARTS
        // =========================================================

        function destroyCharts() {

            if (salesBarChart) {
                salesBarChart.destroy();
                salesBarChart = null;
            }

            if (salesPieChart) {
                salesPieChart.destroy();
                salesPieChart = null;
            }

            if (productsBarChart) {
                productsBarChart.destroy();
                productsBarChart = null;
            }

            if (returnsBarChart) {
                returnsBarChart.destroy();
                returnsBarChart = null;
            }

            if (returnsLineChart) {
                returnsLineChart.destroy();
                returnsLineChart = null;
            }

            if (customersSpendingChart) {
                customersSpendingChart.destroy();
                customersSpendingChart = null;
            }

            if (customersPurchasesChart) {
                customersPurchasesChart.destroy();
                customersPurchasesChart = null;
            }

            if (incomeLineChart) {
                incomeLineChart.destroy();
                incomeLineChart = null;
            }

            if (incomeBreakdownChart) {
                incomeBreakdownChart.destroy();
                incomeBreakdownChart = null;
            }
            if (inventoryStockChart) {
                inventoryStockChart.destroy();
                inventoryStockChart = null;
            }

            if (inventoryStatusChart) {
                inventoryStatusChart.destroy();
                inventoryStatusChart = null;
            }
        }


        // =========================================================
        // RENDER SALES TABLE
        // =========================================================

        function renderSalesTable(sales) {

            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (!tableHead || !tableBody) {
                return;
            }

            if (!sales || sales.length === 0) {
                tableHead.innerHTML = `<tr><th>No data</th></tr>`;

                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            No sales found for the selected period.
                        </td>
                    </tr>`;

                return;
            }

            tableHead.innerHTML = `
                <tr>
                    <th>Sale Number</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Cashier</th>
                    <th>Subtotal</th>
                    <th>Discount</th>
                    <th>Tax</th>
                    <th>Grand Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                </tr>`;

            tableBody.innerHTML = sales.map(sale => {

                const saleDate = sale.date
                    ? new Date(sale.date)
                    : null;

                const formattedDate = saleDate && !isNaN(saleDate)
                    ? saleDate.toLocaleDateString("en-IN", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    })
                    : "-";

                const status = sale.status || "-";

                let statusClass = "bg-secondary";

                if (status === "Paid") {
                    statusClass = "bg-success";
                }
                else if (status === "PendingPayment") {
                    statusClass = "bg-warning text-dark";
                }

                return `
                    <tr>
                        <td class="fw-semibold">
                            ${escapeHtml(sale.saleNumber || "-")}
                        </td>
                        <td>${formattedDate}</td>
                        <td>
                            ${escapeHtml(sale.customer || "Walk-in Customer")}
                        </td>
                        <td>
                            ${escapeHtml(sale.cashier || "-")}
                        </td>
                        <td>${formatCurrency(sale.subtotal)}</td>
                        <td>${formatCurrency(sale.discount)}</td>
                        <td>${formatCurrency(sale.tax)}</td>
                        <td class="fw-semibold">
                            ${formatCurrency(sale.grandTotal)}
                        </td>
                        <td>
                            ${escapeHtml(sale.paymentMethod || "-")}
                        </td>
                        <td>
                            <span class="badge ${statusClass}">
                                ${escapeHtml(status)}
                            </span>
                        </td>
                    </tr>`;
            }).join("");
        }


        // =========================================================
        // RENDER PRODUCTS TABLE
        // =========================================================

        function renderProductsTable(products) {

            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (!tableHead || !tableBody) return;

            if (!products || products.length === 0) {
                tableHead.innerHTML = `<tr><th>No data</th></tr>`;
                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            No product sales found for the selected period.
                        </td>
                    </tr>`;
                return;
            }

            tableHead.innerHTML = `
                <tr>
                    <th>Product</th>
                    <th>Quantity Sold</th>
                    <th>Sales Amount</th>
                </tr>`;

            tableBody.innerHTML = products.map(product => `
                <tr>
                    <td class="fw-semibold">${escapeHtml(product.productName || "-")}</td>
                    <td>${Number(product.quantitySold || 0).toLocaleString("en-IN")}</td>
                    <td class="fw-semibold">${formatCurrency(product.salesAmount)}</td>
                </tr>`
            ).join("");
        }


        // =========================================================
        // RENDER PRODUCTS CHART
        // =========================================================

        function renderProductsChart(products) {

            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");
            const barColumn = document.getElementById("barChartColumn");
            const pieColumn = document.getElementById("pieChartColumn");

            if (!barContainer || !pieContainer || !barColumn || !pieColumn) return;

            destroyCharts();

            // Products needs only one visualization, so use the full width.
            barColumn.className = "col-12";
            pieColumn.style.display = "none";

            if (!products || products.length === 0) {
                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-box-seam fs-1 mb-2"></i>
                        <div class="fw-semibold">No product data</div>
                        <small>No products were sold during the selected period.</small>
                    </div>`;
                return;
            }

            barContainer.innerHTML = `
                <div class="report-chart-header">
                    <div class="report-chart-title">Top Products by Quantity Sold</div>
                    <div class="report-chart-subtitle">Highest-selling products by units</div>
                </div>
                <div class="report-chart-canvas">
                    <canvas id="productsBarChart"></canvas>
                </div>`;

            const chartProducts = products.slice(0, 10);
            const labels = chartProducts.map(p => p.productName || "Unknown Product");
            const values = chartProducts.map(p => Number(p.quantitySold || 0));
            const canvas = document.getElementById("productsBarChart");

            if (!canvas) return;

            const context = canvas.getContext("2d");
            const gradient = context.createLinearGradient(0, 0, 600, 0);
            gradient.addColorStop(0, "#0d6efd");
            gradient.addColorStop(0.55, "#4f9cff");
            gradient.addColorStop(1, "#8abfff");

            const hoverGradient = context.createLinearGradient(0, 0, 600, 0);
            hoverGradient.addColorStop(0, "#084298");
            hoverGradient.addColorStop(0.55, "#0d6efd");
            hoverGradient.addColorStop(1, "#6faeff");

            productsBarChart = new Chart(canvas, {
                type: "bar",
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Quantity Sold",
                        data: values,
                        backgroundColor: gradient,
                        hoverBackgroundColor: hoverGradient,
                        borderWidth: 0,
                        borderRadius: 8,
                        borderSkipped: false,
                        barPercentage: 0.65,
                        categoryPercentage: 0.72
                    }]
                },
                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 700, easing: "easeOutQuart" },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: "rgba(18, 24, 38, 0.96)",
                            titleColor: "#ffffff",
                            bodyColor: "#ffffff",
                            padding: 13,
                            cornerRadius: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    return " " + Number(context.raw || 0).toLocaleString("en-IN") + " units sold";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: { color: "rgba(0, 0, 0, 0.055)", drawTicks: false },
                            border: { display: false },
                            ticks: { color: "#6c757d", padding: 8, precision: 0, font: { size: 11 } }
                        },
                        y: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { color: "#495057", padding: 8, font: { size: 11, weight: "500" } }
                        }
                    }
                }
            });
        }


        // =========================================================
        // RENDER RETURNS TABLE
        // =========================================================

        function renderReturnsTable(returns) {

            const tableHead = document.getElementById("reportTableHead");
            const tableBody = document.getElementById("reportTableBody");

            if (!tableHead || !tableBody) return;

            if (!returns || returns.length === 0) {
                tableHead.innerHTML = `<tr><th>No data</th></tr>`;
                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted py-4">
                            No completed returns found for the selected period.
                        </td>
                    </tr>`;
                return;
            }

            tableHead.innerHTML = `
                <tr>
                    <th>Return Number</th>
                    <th>Sale Number</th>
                    <th>Return Date</th>
                    <th>Refund Amount</th>
                    <th>Processed By</th>
                    <th>Reason</th>
                </tr>`;

            tableBody.innerHTML = returns.map(item => {
                const date = item.returnDate
                    ? new Date(item.returnDate).toLocaleString("en-IN", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit"
                    })
                    : "-";

                return `
                    <tr>
                        <td class="fw-semibold">${escapeHtml(item.returnNumber || "-")}</td>
                        <td>${escapeHtml(item.saleNumber || "-")}</td>
                        <td>${escapeHtml(date)}</td>
                        <td class="fw-semibold">${formatCurrency(item.refundAmount)}</td>
                        <td>${escapeHtml(item.processedBy || "-")}</td>
                        <td>${escapeHtml(item.reason || "No reason recorded")}</td>
                    </tr>`;
            }).join("");
        }


        // =========================================================
        // RENDER RETURNS CHARTS
        // =========================================================

        function renderReturnsCharts(returns) {

            const barColumn = document.getElementById("barChartColumn");
            const pieColumn = document.getElementById("pieChartColumn");
            const barContainer = document.getElementById("barChartContainer");
            const pieContainer = document.getElementById("pieChartContainer");

            if (!barColumn || !pieColumn || !barContainer || !pieContainer) return;

            barColumn.className = "col-lg-6";
            pieColumn.className = "col-lg-6";
            pieColumn.style.display = "";

            destroyCharts();

            if (!returns || returns.length === 0) {
                barContainer.innerHTML = `
                    <div class="report-empty-state">
                        <i class="bi bi-bar-chart fs-1 mb-2"></i>
                        <div class="fw-semibold">No return activity</div>
                        <small>No completed returns found for the selected period.</small>
                    </div>`;

                pieContainer.innerHTML = `
