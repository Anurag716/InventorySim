@model Inventory.ViewModels.SaleCreateViewModel

@{
    ViewData["Title"] = "New Sale";
}
<style>
/* =========================================
   Sale Processing Overlay
   ========================================= */

.sale-processing-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: none;

    align-items: center;
    justify-content: center;

    background: rgba(255, 255, 255, 0.55);

    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
}

.sale-processing-overlay.show {
    display: flex;
}

.sale-processing-box {
    width: 340px;
    max-width: calc(100% - 40px);

    padding: 30px;

    text-align: center;

    background: #ffffff;

    border-radius: 16px;

    box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.15);
}

.sale-processing-spinner {
    width: 55px;
    height: 55px;

    border-width: 5px;
}

.sale-result-icon {
    width: 65px;
    height: 65px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 38px;
}

.sale-success-icon {
    background: #d1e7dd;
    color: #198754;
}

.sale-error-icon {
    background: #f8d7da;
    color: #dc3545;
}

</style>
<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="mb-1">New Sale</h2>
        <p class="text-muted mb-0">
            Create a new customer sale.
        </p>
    </div>


    <div class="row g-4">

        <!-- LEFT SIDE -->
        <div class="col-lg-8">

            <!-- Customer & Product Selection -->
            <div class="card shadow-sm mb-4">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cart-plus"></i>
                        Add Products
                    </h5>
                </div>

                <div class="card-body">

                    <!-- CUSTOMER -->
                    <div class="mb-4">

                        <label asp-for="CustomerId"
                               class="form-label">
                            Customer
                        </label>

                        <div class="d-flex gap-2">

                            <select asp-for="CustomerId"
                                    asp-items="Model.Customers"
                                    class="form-select"
                                    id="customerSelect">

                                <option value="">
                                    Walk-in Customer
                                </option>

                            </select>

                            <button type="button"
                                    id="addCustomerButton"
                                    class="btn btn-outline-primary text-nowrap">

                                <i class="bi bi-person-plus"></i>
                                Add Customer

                            </button>

                        </div>

                    </div>


                    <!-- PRODUCT SELECTION -->
                    <div class="row g-3 align-items-end">

                        <div class="col-md-7">

                            <label class="form-label">
                                Product
                            </label>

                            <select id="productSelect"
                                    class="form-select">

                                <option value="">
                                    Select Product
                                </option>

                                @foreach (var product in Model.Products)
                                {
                                   <option value="@product.ProductId"
        data-price="@product.PurchasePrice"
        data-stock="@product.CurrentStock">

    @product.ProductName
    (@product.Sku) - Stock: @product.CurrentStock

</option>
                                }

                            </select>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input type="number"
                                   id="productQuantity"
                                   class="form-control"
                                   value="1"
                                   min="1" />

                        </div>


                        <div class="col-md-2">

                            <button type="button"
                                    id="addProductButton"
                                    class="btn btn-primary w-100">

                                <i class="bi bi-plus-lg"></i>
                                Add

                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CART -->
            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        <i class="bi bi-cart3"></i>
                        Sale Items
                    </h5>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Product
                                    </th>

                                    <th class="text-center">
                                        Quantity
                                    </th>

                                    <th class="text-end">
                                        Unit Price
                                    </th>

                                    <th class="text-end">
                                        Subtotal
                                    </th>

                                    <th class="text-end">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="cartBody">

                                <tr>

                                    <td colspan="5"
                                        class="text-center text-muted py-5">

                                        <i class="bi bi-cart-x fs-2"></i>

                                        <div class="mt-2">
                                            No products added yet.
                                        </div>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-receipt"></i>
                        Sale Summary

                    </h5>

                </div>


                <div class="card-body">

                    <!-- SUBTOTAL -->
                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            Subtotal
                        </span>

                        <strong id="subtotalAmount">
                            ₹0.00
                        </strong>

                    </div>


                    <!-- DISCOUNT -->
                    <div class="mb-3">

                        <label asp-for="DiscountPercentage"
                               class="form-label">

                            Discount

                        </label>

                        <div class="row g-2">

                            <!-- Percentage -->
                            <div class="col-5">

                                <div class="input-group">

                                    <input asp-for="DiscountPercentage"
                                           id="discountPercentage"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="0" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </div>


                            <!-- Calculated Amount -->
                            <div class="col-7">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input type="text"
                                           id="discountAmount"
                                           class="form-control"
                                           value="0.00"
                                           readonly />

                                </div>

                            </div>

                        </div>

                        <small class="text-muted">
                            Discount amount
                        </small>

                    </div>


                    <!-- TAX -->
                    <div class="mb-3">

                        <label asp-for="TaxPercentage"
                               class="form-label">

                            Tax

                        </label>

                        <div class="row g-2">

                            <!-- Percentage -->
                            <div class="col-5">

                                <div class="input-group">

                                    <input asp-for="TaxPercentage"
                                           id="taxPercentage"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="0" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </div>


                            <!-- Calculated Amount -->
                            <div class="col-7">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input type="text"
                                           id="taxAmount"
                                           class="form-control"
                                           value="0.00"
                                           readonly />

                                </div>

                            </div>

                        </div>

                        <small class="text-muted">
                            Tax amount
                        </small>

                    </div>


                    <hr />


                    <!-- GRAND TOTAL -->
                    <div class="d-flex justify-content-between mb-4">

                        <span class="fs-5">
                            Grand Total
                        </span>

                        <strong class="fs-4"
                                id="grandTotalAmount">

                            ₹0.00

                        </strong>

                    </div>


                    <!-- COMPLETE SALE -->
                    <button type="button"
                            id="completeSaleButton"
                            class="btn btn-success btn-lg w-100">

                        <i class="bi bi-check-circle"></i>
                        Complete Sale

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
@Html.AntiForgeryToken()
<!-- Sale Processing Overlay -->
<div id="saleProcessingOverlay"
     class="sale-processing-overlay">

    <div class="sale-processing-box">

        <!-- Spinner -->
        <div id="saleProcessingSpinner"
             class="spinner-border text-primary sale-processing-spinner"
             role="status">
            <span class="visually-hidden">
                Processing...
            </span>
        </div>

        <!-- Success Icon -->
        <div id="saleSuccessIcon"
             class="sale-result-icon sale-success-icon d-none">
            <i class="bi bi-check-lg"></i>
        </div>

        <!-- Error Icon -->
        <div id="saleErrorIcon"
             class="sale-result-icon sale-error-icon d-none">
            <i class="bi bi-x-lg"></i>
        </div>

        <h4 id="saleProcessingTitle"
            class="mt-3 mb-2">
            Processing Sale...
        </h4>

        <p id="saleProcessingMessage"
           class="text-muted mb-0">
            Please wait while we confirm the sale.
        </p>

    </div>

</div>
<!-- ========================================== -->
<!-- GENERAL NOTIFICATION MODAL -->
<!-- ========================================== -->

<div class="modal fade"
     id="notificationModal"
     tabindex="-1"
     aria-labelledby="notificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="notificationModalLabel">

                    Notification

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="d-flex align-items-start">

                    <i id="notificationIcon"
                       class="bi bi-info-circle fs-3 me-3">
                    </i>

                    <div id="notificationMessage">
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">

                    OK

                </button>

            </div>

        </div>

    </div>

</div>
<!-- ========================================== -->
<!-- ADD CUSTOMER MODAL -->
<!-- ========================================== -->

<div class="modal fade"
     id="addCustomerModal"
     tabindex="-1"
     aria-labelledby="addCustomerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="addCustomerModalLabel">
                    Add Customer
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label for="customerName"
                           class="form-label">
                        Name
                    </label>

                    <input type="text"
                           id="customerName"
                           class="form-control"
                           maxlength="150"
                           placeholder="Enter customer name">
                </div>

                <div class="mb-3">
                    <label for="customerPhone"
                           class="form-label">
                        Phone
                    </label>

                    <input type="text"
                           id="customerPhone"
                           class="form-control"
                           maxlength="20"
                           placeholder="Enter phone number">
                </div>

                <div class="mb-3">
                    <label for="customerEmail"
                           class="form-label">
                        Email
                    </label>

                    <input type="email"
                           id="customerEmail"
                           class="form-control"
                           maxlength="150"
                           placeholder="Enter email address">
                </div>

                <div class="mb-3">
                    <label for="customerAddress"
                           class="form-label">
                        Address
                    </label>

                    <textarea id="customerAddress"
                              class="form-control"
                              maxlength="500"
                              rows="3"
                              placeholder="Enter address"></textarea>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="saveCustomerButton"
                        class="btn btn-primary">
                    <i class="bi bi-person-plus"></i>
                    Save Customer
                </button>

            </div>

        </div>

    </div>
</div>


@section Scripts {

<script>

    // ==========================================
    // CART
    // ==========================================

    let cart = [];


    // ==========================================
    // ELEMENTS
    // ==========================================

    const productSelect =
        document.getElementById("productSelect");

    const productQuantity =
        document.getElementById("productQuantity");

    const addProductButton =
        document.getElementById("addProductButton");

    const cartBody =
        document.getElementById("cartBody");

    const discountPercentage =
        document.getElementById("discountPercentage");

    const taxPercentage =
        document.getElementById("taxPercentage");

    const subtotalAmount =
        document.getElementById("subtotalAmount");

    const discountAmount =
        document.getElementById("discountAmount");

    const taxAmount =
        document.getElementById("taxAmount");

    const grandTotalAmount =
        document.getElementById("grandTotalAmount");

    const addCustomerButton =
        document.getElementById("addCustomerButton");

    const notificationModalElement =
        document.getElementById("notificationModal");

    const notificationModal =
        new bootstrap.Modal(notificationModalElement);

    const notificationModalLabel =
        document.getElementById("notificationModalLabel");

    const notificationMessage =
        document.getElementById("notificationMessage");

    const notificationIcon =
        document.getElementById("notificationIcon");
const saleProcessingOverlay =
    document.getElementById("saleProcessingOverlay");

const saleProcessingSpinner =
    document.getElementById("saleProcessingSpinner");

const saleSuccessIcon =
    document.getElementById("saleSuccessIcon");

const saleErrorIcon =
    document.getElementById("saleErrorIcon");

const saleProcessingTitle =
    document.getElementById("saleProcessingTitle");

const saleProcessingMessage =
    document.getElementById("saleProcessingMessage");


    // ==========================================
    // FORMAT CURRENCY
    // ==========================================

    function formatCurrency(amount) {

        return amount.toLocaleString("en-IN", {

            minimumFractionDigits: 2,

            maximumFractionDigits: 2

        });

    }


    // ==========================================
    // GENERAL NOTIFICATION MODAL
    // ==========================================

    function showNotification(type, message) {

        notificationModalLabel.textContent =
            type;

        notificationMessage.textContent =
            message;


        // Reset icon
        notificationIcon.className =
            "bi fs-3 me-3";


        if (type === "Error") {

            notificationIcon.classList.add(
                "bi-exclamation-circle",
                "text-danger"
            );

        }
        else if (type === "Warning") {

            notificationIcon.classList.add(
                "bi-exclamation-triangle",
                "text-warning"
            );

        }
        else if (type === "Success") {

            notificationIcon.classList.add(
                "bi-check-circle",
                "text-success"
            );

        }
        else {

            notificationIcon.classList.add(
                "bi-info-circle",
                "text-primary"
            );

        }


        notificationModal.show();

    }
// ==========================================
// SALE PROCESSING
// ==========================================  
function showSaleProcessing() {

    saleProcessingOverlay.classList.add("show");

    saleProcessingSpinner.classList.remove("d-none");
    saleSuccessIcon.classList.add("d-none");
    saleErrorIcon.classList.add("d-none");

    saleProcessingTitle.textContent =
        "Processing Sale...";

    saleProcessingMessage.textContent =
        "Please wait while we confirm the sale.";
}
// ==========================================
// SALE SUCCESS
// ==========================================
function showSaleSuccess() {

    saleProcessingSpinner.classList.add("d-none");
    saleErrorIcon.classList.add("d-none");

    saleSuccessIcon.classList.remove("d-none");

    saleProcessingTitle.textContent =
        "Sale Completed";

    saleProcessingMessage.textContent =
        "Sale saved successfully. Redirecting to payment...";
}
// ==========================================
// SALE ERROR
// ==========================================
function showSaleError(message) {

    saleProcessingSpinner.classList.add("d-none");
    saleSuccessIcon.classList.add("d-none");

    saleErrorIcon.classList.remove("d-none");

    saleProcessingTitle.textContent =
        "Sale Failed";

    saleProcessingMessage.textContent =
        message || "Unable to complete the sale.";

    setTimeout(function () {

        saleProcessingOverlay.classList.remove("show");

    }, 1500);
}

    // ==========================================
    // ADD PRODUCT
    // ==========================================

    addProductButton.addEventListener(
        "click",
        function () {

            const productId =
                productSelect.value;

            const quantity =
                parseInt(productQuantity.value);


            if (!productId) {

                showNotification(
                    "Error",
                    "Please select a product."
                );

                return;

            }


            if (!quantity || quantity < 1) {

                showNotification(
                    "Error",
                    "Quantity must be at least 1."
                );

                return;

            }


            const selectedOption =
                productSelect.options[
                    productSelect.selectedIndex
                ];


            const productName =
                selectedOption.textContent.trim();


            const unitPrice =
                parseFloat(
                    selectedOption.dataset.price
                );


         const stock =
    parseInt(selectedOption.dataset.stock);


const existingItem =
    cart.find(function (item) {

        return item.productId == productId;

    });


if (existingItem) {

    const newQuantity =
        existingItem.quantity + quantity;


    if (newQuantity > stock) {

        showNotification(
            "Warning",
            `Only ${stock} units of this product are available.`
        );

        return;

    }


    existingItem.quantity = newQuantity;

}
else {

    if (quantity > stock) {

        showNotification(
            "Warning",
            `Only ${stock} units of this product are available.`
        );

        return;

    }


    cart.push({

        productId: productId,

        productName: productName,

        quantity: quantity,

        unitPrice: unitPrice,

        stock: stock

    });

}

            productSelect.value = "";

            productQuantity.value = 1;

            renderCart();

        }
    );


    // ==========================================
    // RENDER CART
    // ==========================================

    function renderCart() {

        cartBody.innerHTML = "";


        // ======================================
        // EMPTY CART
        // ======================================

        if (cart.length === 0) {

            cartBody.innerHTML = `

                <tr>

                    <td colspan="5"
                        class="text-center text-muted py-5">

                        <i class="bi bi-cart-x fs-2"></i>

                        <div class="mt-2">
                            No products added yet.
                        </div>

                    </td>

                </tr>

            `;


            // Reset percentage inputs
            discountPercentage.value = 0;

            taxPercentage.value = 0;


            updateSummary();

            return;

        }


        // ======================================
        // RENDER ITEMS
        // ======================================

        cart.forEach(function (item, index) {

            const subtotal =
                item.quantity *
                item.unitPrice;


            const row =
                document.createElement("tr");


            row.innerHTML = `

                <td>

                    <strong>
                        ${item.productName}
                    </strong>

                </td>


                <td class="text-center">

                    <div class="d-inline-flex
                                align-items-center
                                border
                                rounded">

                        <button type="button"
                                class="btn btn-sm
                                       btn-light
                                       quantity-minus"
                                data-index="${index}">

                            <i class="bi bi-dash"></i>

                        </button>


                        <span class="px-3"
                              style="min-width: 45px;">

                            ${item.quantity}

                        </span>


                        <button type="button"
                                class="btn btn-sm
                                       btn-light
                                       quantity-plus"
                                data-index="${index}">

                            <i class="bi bi-plus"></i>

                        </button>

                    </div>

                </td>


                <td class="text-end">

                    ₹${formatCurrency(item.unitPrice)}

                </td>


                <td class="text-end">

                    ₹${formatCurrency(subtotal)}

                </td>


                <td class="text-end">

                    <button type="button"
                            class="btn btn-sm
                                   btn-outline-danger
                                   remove-item"
                            data-index="${index}">

                        <i class="bi bi-trash"></i>

                    </button>

                </td>

            `;


            cartBody.appendChild(row);

        });


        // ======================================
        // MINUS BUTTON
        // ======================================

        document
            .querySelectorAll(".quantity-minus")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const index =
                            parseInt(
                                this.dataset.index
                            );


                        if (cart[index].quantity > 1) {

                            cart[index].quantity--;

                            renderCart();

                        }

                    }
                );

            });


        // ======================================
        // PLUS BUTTON
        // ======================================

       document
    .querySelectorAll(".quantity-plus")
    .forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                const index =
                    parseInt(
                        this.dataset.index
                    );


                const item = cart[index];


                if (item.quantity >= item.stock) {

                    showNotification(
                        "Warning",
                        `Only ${item.stock} units of ${item.productName} are available.`
                    );

                    return;

                }


                item.quantity++;

                renderCart();

            }
        );

    });


        // ======================================
        // REMOVE ITEM
        // ======================================

        document
            .querySelectorAll(".remove-item")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const index =
                            parseInt(
                                this.dataset.index
                            );


                        cart.splice(index, 1);

                        renderCart();

                    }
                );

            });


        updateSummary();

    }


    // ==========================================
    // CALCULATE SUBTOTAL
    // ==========================================

    function calculateSubtotal() {

        let subtotal = 0;


        cart.forEach(function (item) {

            subtotal +=
                item.quantity *
                item.unitPrice;

        });


        return subtotal;

    }


    // ==========================================
    // UPDATE SUMMARY
    // ==========================================

    function updateSummary() {

        const subtotal =
            calculateSubtotal();


        const discountPercentageValue =
            parseFloat(
                discountPercentage.value
            ) || 0;


        const taxPercentageValue =
            parseFloat(
                taxPercentage.value
            ) || 0;


        // ======================================
        // DISCOUNT
        // ======================================

        const discount =
            subtotal *
            discountPercentageValue /
            100;


        // ======================================
        // TAXABLE AMOUNT
        // ======================================

        const taxableAmount =
            Math.max(
                subtotal - discount,
                0
            );


        // ======================================
        // TAX
        // ======================================

        const tax =
            taxableAmount *
            taxPercentageValue /
            100;


        // ======================================
        // GRAND TOTAL
        // ======================================

        const grandTotal =
            taxableAmount + tax;


        // ======================================
        // DISPLAY VALUES
        // ======================================

        subtotalAmount.textContent =
            "₹" +
            formatCurrency(subtotal);


        discountAmount.value =
            formatCurrency(discount);


        taxAmount.value =
            formatCurrency(tax);


        grandTotalAmount.textContent =
            "₹" +
            formatCurrency(
                Math.max(grandTotal, 0)
            );

    }


    // ==========================================
    // DISCOUNT CHANGE
    // ==========================================

    discountPercentage.addEventListener(
        "input",
        updateSummary
    );


    // ==========================================
    // TAX CHANGE
    // ==========================================

    taxPercentage.addEventListener(
        "input",
        updateSummary
    );



 // ==========================================
// ADD CUSTOMER
// ==========================================

const addCustomerModalElement =
    document.getElementById("addCustomerModal");

const addCustomerModal =
    new bootstrap.Modal(addCustomerModalElement);

const saveCustomerButton =
    document.getElementById("saveCustomerButton");

const customerName =
    document.getElementById("customerName");

const customerPhone =
    document.getElementById("customerPhone");

const customerEmail =
    document.getElementById("customerEmail");

const customerAddress =
    document.getElementById("customerAddress");


addCustomerButton.addEventListener(
    "click",
    function () {

        customerName.value = "";
        customerPhone.value = "";
        customerEmail.value = "";
        customerAddress.value = "";

        addCustomerModal.show();
    }
);


saveCustomerButton.addEventListener(
    "click",
    async function () {

        const name =
            customerName.value.trim();

       if (!name) {

    addCustomerModal.hide();

    addCustomerModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            showNotification(
                "Error",
                "Customer name is required."
            );

        },
        { once: true }
    );

    return;
}


        saveCustomerButton.disabled = true;

        saveCustomerButton.innerHTML =
            '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';


        try {

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            const formData =
                new FormData();

            formData.append(
                "Name",
                name
            );

            formData.append(
                "Phone",
                customerPhone.value.trim()
            );

            formData.append(
                "Email",
                customerEmail.value.trim()
            );

            formData.append(
                "Address",
                customerAddress.value.trim()
            );

            formData.append(
                "__RequestVerificationToken",
                token
            );


            const response =
                await fetch(
                    "/Sales/AddCustomerFromPos",
                    {
                        method: "POST",
                        body: formData
                    }
                );


            const result =
                await response.json();


            if (!response.ok || !result.success) {

                showNotification(
                    "Error",
                    result.message ||
                    "Unable to add customer."
                );

                return;
            }


            // Add the new customer to dropdown
            const customerSelect =
                document.getElementById(
                    "customerSelect"
                );


            const option =
                document.createElement("option");

            option.value =
                result.customerId;

            option.textContent =
                result.customerName;

            option.selected = true;


            customerSelect.appendChild(option);


            // Close Add Customer modal
            addCustomerModal.hide();


            // Show success message
            showNotification(
                "Success",
                result.message
            );

        }
        catch (error) {

            console.error(
                "Add customer error:",
                error
            );

            showNotification(
                "Error",
                "An unexpected error occurred while adding the customer."
            );

        }
        finally {

            saveCustomerButton.disabled = false;

            saveCustomerButton.innerHTML =
                '<i class="bi bi-person-plus"></i> Save Customer';

        }

    }
);
// ==========================================
// COMPLETE SALE
// ==========================================

completeSaleButton.addEventListener(
    "click",
    async function () {

        /*
         * First make sure the cart isn't empty.
         */
        if (cart.length === 0) {

            showNotification(
                "Error",
                "Please add at least one product to the sale."
            );

            return;
        }


        /*
         * Prepare the customer information.
         */
        const customerSelect =
            document.getElementById("customerSelect");


        /*
         * Prepare the request that will be
         * sent to the server.
         */
        const requestData = {

            customerId:
                customerSelect.value
                    ? parseInt(customerSelect.value)
                    : null,

            items: cart.map(function (item) {

                return {

                    productId:
                        parseInt(item.productId),

                    quantity:
                        item.quantity,

                    /*
                     * This value is sent only as part
                     * of the request structure.
                     *
                     * The server will retrieve the
                     * real selling price from the DB.
                     */
                    unitPrice:
                        item.unitPrice,

                    discountAmount: 0
                };

            }),

            discountPercentage:
                parseFloat(
                    discountPercentage.value
                ) || 0,

            taxPercentage:
                parseFloat(
                    taxPercentage.value
                ) || 0
        };


        /*
         * Show the full-screen processing overlay.
         *
         * From this point the cashier cannot
         * interact with the POS.
         */
        showSaleProcessing();


        try {

            /*
             * Get the Anti-Forgery Token.
             */
            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            /*
             * Send the sale to the server.
             */
            const response =
                await fetch(
                    "/Sales/Create",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "RequestVerificationToken":
                                token
                        },

                        body:
                            JSON.stringify(requestData)
                    }
                );


            /*
             * Read the server response.
             */
            const result =
                await response.json();


            /*
             * Something went wrong.
             */
            if (!response.ok || !result.success) {

                showSaleError(
                    result.message ||
                    "Unable to complete the sale."
                );

                return;
            }


            /*
             * The database transaction has
             * successfully committed.
             *
             * Now show the green checkmark.
             */
            showSaleSuccess();


            /*
             * Clear the POS state.
             *
             * This prevents old cart data from
             * remaining if the POS page is opened
             * again.
             */
            cart.length = 0;


            /*
             * Clear the product selection.
             */
            const productSelect =
                document.getElementById("productSelect");

            if (productSelect) {
                productSelect.value = "";
            }


            /*
             * Reset quantity.
             */
            const productQuantity =
                document.getElementById("productQuantity");

            if (productQuantity) {
                productQuantity.value = 1;
            }


            /*
             * Reset customer.
             */
            if (customerSelect) {
                customerSelect.value = "";
            }


            /*
             * Reset discount.
             */
            discountPercentage.value = 0;


            /*
             * Reset tax.
             */
            taxPercentage.value = 0;


            /*
             * Re-render the empty cart and
             * reset all calculated amounts.
             */
            renderCart();

            updateSummary();


            /*
             * Give the cashier a short moment
             * to see the success message.
             */
            setTimeout(function () {

                /*
                 * Redirect to the payment page
                 * for THIS specific sale.
                 */
                window.location.href =
                    "/Sales/Payment/" +
                    result.saleId;

            }, 1000);

        }
        catch (error) {

            console.error(
                "Complete sale error:",
                error
            );


            /*
             * The server could not be reached
             * or an unexpected error occurred.
             */
            showSaleError(
                "An unexpected error occurred while completing the sale."
            );
        }

    }
);
    // ==========================================
    // INITIAL SUMMARY
    // ==========================================

    updateSummary();

</script>

}