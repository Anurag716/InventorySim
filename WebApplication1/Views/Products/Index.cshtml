@model IEnumerable<Inventory.Models.Product>

@{
    ViewData["Title"] = "Products";

    bool isAdmin = User.IsInRole("Admin");
    bool isCashier = User.IsInRole("Cashier");
}

<div class="container-fluid mt-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

   <div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>Products</h2>

        @if (User.IsInRole("Admin"))
        {
            <p>Manage products, pricing, stock levels, and suppliers.</p>
        }
        else
        {
            <p>View product information, pricing, and stock availability.</p>
        }
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Product
        </a>
    }
</div>


    <!-- ========================================================= -->
    <!-- PRODUCTS TABLE -->
    <!-- ========================================================= -->

    <div class="table-responsive">

        <table class="table table-bordered table-striped align-middle">

            <thead>
                <tr>

                    <th>SKU</th>

                    <th>Name</th>

                    <th>Category</th>

                    @if (isAdmin)
                    {
                        <th>Supplier</th>
                        <th>Purchase Price</th>
                    }

                    <th>Selling Price</th>

                    <th>Stock</th>

                    @if (isAdmin)
                    {
                        <th>Reorder Level</th>
                    }

                    <th>Status</th>

                    <th>Actions</th>

                </tr>
            </thead>


            <tbody>

                @foreach (var product in Model)
                {
                    <tr>

                        <!-- SKU -->
                        <td>
                            @product.Sku
                        </td>


                        <!-- Product Name -->
                        <td>
                            @product.Name
                        </td>


                        <!-- Category -->
                        <td>
                            @(product.Category?.Name ?? "Not assigned")
                        </td>


                        @if (isAdmin)
                        {
                            <!-- Supplier -->
                            <td>
                                @(product.PreferredSupplier?.Name ?? "Not assigned")
                            </td>


                            <!-- Purchase Price -->
                            <td>
                                ₹@product.PurchasePrice.ToString("0.00")
                            </td>
                        }


                        <!-- Selling Price -->
                        <td>
                            ₹@product.SellingPrice.ToString("0.00")
                        </td>


                        <!-- Current Stock -->
                        <td>
                            @product.CurrentStock
                        </td>


                        @if (isAdmin)
                        {
                            <!-- Reorder Level -->
                            <td>
                                @product.ReorderLevel
                            </td>
                        }


                        <!-- Status -->
                        <td>
                            @if (product.IsActive == true)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }
                        </td>


                        <!-- Actions -->
                        <td class="text-nowrap">

                            <!-- Details: Admin + Cashier -->
                            <button type="button"
                                    class="btn btn-sm btn-info"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detailsModal-@product.ProductId">
                                Details
                            </button>


                            @if (isAdmin)
                            {
                                <!-- Edit: Admin only -->
                                <a asp-action="Edit"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-sm btn-warning ms-1">
                                    Edit
                                </a>


                                <!-- Delete: Admin only -->
                                <button type="button"
                                        class="btn btn-sm btn-danger ms-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@product.ProductId">
                                    Delete
                                </button>
                            }

                        </td>

                    </tr>


                    <!-- ================================================= -->
                    <!-- DETAILS MODAL -->
                    <!-- Admin + Cashier -->
                    <!-- ================================================= -->

                    <div class="modal fade"
                         id="detailsModal-@product.ProductId"
                         tabindex="-1"
                         aria-labelledby="detailsModalLabel-@product.ProductId"
                         aria-hidden="true">

                        <div class="modal-dialog modal-lg">

                            <div class="modal-content">


                                <!-- Modal Header -->
                                <div class="modal-header">

                                    <h5 class="modal-title"
                                        id="detailsModalLabel-@product.ProductId">
                                        Product Details
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>

                                </div>


                                <!-- Modal Body -->
                                <div class="modal-body">

                                    <div class="row">

                                        <!-- SKU -->
                                        <div class="col-md-6 mb-3">

                                            <strong>SKU:</strong>

                                            <div>
                                                @product.Sku
                                            </div>

                                        </div>


                                        <!-- Product Name -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Product Name:</strong>

                                            <div>
                                                @product.Name
                                            </div>

                                        </div>


                                        <!-- Category -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Category:</strong>

                                            <div>
                                                @(product.Category?.Name ?? "Not assigned")
                                            </div>

                                        </div>


                                        @if (isAdmin)
                                        {
                                            <!-- Preferred Supplier -->
                                            <div class="col-md-6 mb-3">

                                                <strong>Preferred Supplier:</strong>

                                                <div>
                                                    @(product.PreferredSupplier?.Name ?? "Not assigned")
                                                </div>

                                            </div>


                                            <!-- Purchase Price -->
                                            <div class="col-md-6 mb-3">

                                                <strong>Purchase Price:</strong>

                                                <div>
                                                    ₹@product.PurchasePrice.ToString("0.00")
                                                </div>

                                            </div>
                                        }


                                        <!-- Selling Price -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Selling Price:</strong>

                                            <div>
                                                ₹@product.SellingPrice.ToString("0.00")
                                            </div>

                                        </div>


                                        <!-- Current Stock -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Current Stock:</strong>

                                            <div>
                                                @product.CurrentStock
                                            </div>

                                        </div>


                                        @if (isAdmin)
                                        {
                                            <!-- Reorder Level -->
                                            <div class="col-md-6 mb-3">

                                                <strong>Reorder Level:</strong>

                                                <div>
                                                    @product.ReorderLevel
                                                </div>

                                            </div>
                                        }


                                        <!-- Status -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Status:</strong>

                                            <div>

                                                @if (product.IsActive == true)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Inactive
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <!-- Created At -->
                                        <div class="col-md-6 mb-3">

                                            <strong>Created At:</strong>

                                            <div>
                                                @product.CreatedAt.ToString(
                                                    "dd-MM-yyyy HH:mm")
                                            </div>

                                        </div>


                                        <!-- Description -->
                                        <div class="col-12 mb-3">

                                            <strong>Description:</strong>

                                            <div>

                                                @(string.IsNullOrWhiteSpace(product.Description)
                                                    ? "No description available."
                                                    : product.Description)

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- Modal Footer -->
                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Close
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    @if (isAdmin)
                    {
                        <!-- ================================================= -->
                        <!-- DELETE MODAL -->
                        <!-- Admin only -->
                        <!-- ================================================= -->

                        <div class="modal fade"
                             id="deleteModal-@product.ProductId"
                             tabindex="-1"
                             aria-labelledby="deleteModalLabel-@product.ProductId"
                             aria-hidden="true">

                            <div class="modal-dialog">

                                <div class="modal-content">


                                    <!-- Modal Header -->
                                    <div class="modal-header">

                                        <h5 class="modal-title"
                                            id="deleteModalLabel-@product.ProductId">
                                            Delete Product
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close">
                                        </button>

                                    </div>


                                    <!-- Modal Body -->
                                    <div class="modal-body">

                                        <p>
                                            Are you sure you want to delete this product?
                                        </p>

                                        <strong>
                                            @product.Name
                                        </strong>

                                        <div class="mt-2 text-muted">
                                            SKU: @product.Sku
                                        </div>

                                    </div>


                                    <!-- Modal Footer -->
                                    <div class="modal-footer">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>


                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@product.ProductId" />

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                }

            </tbody>

        </table>

    </div>

</div>
