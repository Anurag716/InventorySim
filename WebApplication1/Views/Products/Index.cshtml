
@model IEnumerable<Inventory.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Product
        </a>
    </div>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>SKU</th>
                <th>Name</th>
                <th>Category</th>
                <th>Supplier</th>
                <th>Purchase Price</th>
                <th>Selling Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var product in Model)
            {
                <tr>

                    <td>@product.Sku</td>

                    <td>@product.Name</td>

                    <td>
                        @(product.Category?.Name ?? "Not assigned")
                    </td>

                    <td>
                        @(product.PreferredSupplier?.Name ?? "Not assigned")
                    </td>

                    <td>
                        @product.PurchasePrice.ToString("0.00")
                    </td>

                    <td>
                        @product.SellingPrice.ToString("0.00")
                    </td>

                    <td>
                        @product.CurrentStock
                    </td>

                    <td>
                        @(product.IsActive == true
                            ? "Active"
                            : "Inactive")
                    </td>

                    <td>

                        <button type="button"
                                class="btn btn-sm btn-info me-1"
                                data-bs-toggle="modal"
                                data-bs-target="#detailsModal-@product.ProductId">
                            Details
                        </button>
                        <a asp-action="Edit"
                           asp-route-id="@product.ProductId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal-@product.ProductId">
                            Delete
                        </button>


                    </td>

                </tr>

                <!-- Details Modal -->
                <div class="modal fade"
                     id="detailsModal-@product.ProductId"
                     tabindex="-1"
                     aria-labelledby="detailsModalLabel-@product.ProductId"
                     aria-hidden="true">

                    <div class="modal-dialog modal-lg">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title"
                                    id="detailsModalLabel-@product.ProductId">
                                    Product Details
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close">
                                </button>
                            </div>

                            <div class="modal-body">

                                <div class="row">

                                    <div class="col-md-6 mb-3">
                                        <strong>SKU:</strong>
                                        <div>@product.Sku</div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Product Name:</strong>
                                        <div>@product.Name</div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Category:</strong>
                                        <div>
                                            @(product.Category?.Name ?? "Not assigned")
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Preferred Supplier:</strong>
                                        <div>
                                            @(product.PreferredSupplier?.Name ?? "Not assigned")
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Purchase Price:</strong>
                                        <div>
                                            ₹@product.PurchasePrice.ToString("0.00")
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Selling Price:</strong>
                                        <div>
                                            ₹@product.SellingPrice.ToString("0.00")
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Current Stock:</strong>
                                        <div>@product.CurrentStock</div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Reorder Level:</strong>
                                        <div>@product.ReorderLevel</div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Status:</strong>
                                        <div>
                                            @(product.IsActive == true
                                                ? "Active"
                                                : "Inactive")
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <strong>Created At:</strong>
                                        <div>
                                            @product.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                                        </div>
                                    </div>

                                    <div class="col-12 mb-3">
                                        <strong>Description:</strong>
                                        <div>
                                            @(string.IsNullOrWhiteSpace(product.Description)
                                                ? "No description available."
                                                : product.Description)
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Close
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
                <!-- Delete Modal -->
                <div class="modal fade"
                     id="deleteModal-@product.ProductId"
                     tabindex="-1"
                     aria-labelledby="deleteModalLabel-@product.ProductId"
                     aria-hidden="true">

                    <div class="modal-dialog">

                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title"
                                    id="deleteModalLabel-@product.ProductId">
                                    Delete Product
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close">
                                </button>
                            </div>

                            <div class="modal-body">

                                <p>
                                    Are you sure you want to delete this product?
                                </p>

                                <strong>
                                    @product.Name
                                </strong>

                                <div class="mt-2 text-muted">
                                    SKU: @product.Sku
                                </div>

                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@product.ProductId" />

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </tbody>

    </table>

</div>