@model Inventory.Models.Product

@{
ViewData["Title"] = "Create Product";
}

<div class="container-fluid mt-4">

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">

    <div>
        <h2>Create Product</h2>
        <p>Add a new product with its category, supplier, pricing, and stock settings.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Products
    </a>

</div>

<!-- Form Section -->
<div class="row justify-content-center">

    <div class="col-12 col-lg-11 col-xl-9">

        <div class="inventra-form-section">

            <div class="inventra-form-section-header">
                <div>
                    <h5 class="mb-1">
                        Product Details
                    </h5>

                    <p class="text-muted mb-0">
                        Enter the product information and inventory settings.
                    </p>
                </div>
            </div>

            <div class="inventra-form-section-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Basic Information -->
                    <div class="mb-4">

                        <h6 class="fw-semibold mb-3">
                            Basic Information
                        </h6>

                        <div class="row">

                            <!-- SKU -->
                            <div class="col-12 col-md-5 mb-3">

                                <label asp-for="Sku"
                                       class="form-label fw-semibold">
                                    SKU
                                </label>

                                <input asp-for="Sku"
                                       class="form-control"
                                       maxlength="50"
                                       placeholder="Enter SKU" />

                                <span asp-validation-for="Sku"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Product Name -->
                            <div class="col-12 col-md-7 mb-3">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">
                                    Product Name
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       maxlength="150"
                                       placeholder="Enter product name" />

                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Description -->
                            <div class="col-12 mb-3">

                                <label asp-for="Description"
                                       class="form-label fw-semibold">
                                    Description
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"
                                          placeholder="Enter a short product description"></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                    <hr class="my-4">

                    <!-- Classification -->
                    <div class="mb-4">

                        <h6 class="fw-semibold mb-3">
                            Classification & Supplier
                        </h6>

                        <div class="row">

                            <!-- Category -->
                            <div class="col-12 col-md-6 mb-3">

                                <label asp-for="CategoryId"
                                       class="form-label fw-semibold">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.Categories"
                                        class="form-select">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Supplier -->
                            <div class="col-12 col-md-6 mb-3">

                                <label asp-for="PreferredSupplierId"
                                       class="form-label fw-semibold">
                                    Preferred Supplier
                                </label>

                                <select asp-for="PreferredSupplierId"
                                        asp-items="ViewBag.Suppliers"
                                        class="form-select">

                                    <option value="">
                                        -- Select Supplier --
                                    </option>

                                </select>

                                <span asp-validation-for="PreferredSupplierId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                    <hr class="my-4">

                    <!-- Pricing & Inventory -->
                    <div class="mb-4">

                        <h6 class="fw-semibold mb-3">
                            Pricing & Inventory
                        </h6>

                        <div class="row">

                            <!-- Purchase Price -->
                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="PurchasePrice"
                                       class="form-label fw-semibold">
                                    Purchase Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="PurchasePrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00" />

                                </div>

                                <span asp-validation-for="PurchasePrice"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Selling Price -->
                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="SellingPrice"
                                       class="form-label fw-semibold">
                                    Selling Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="SellingPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00" />

                                </div>

                                <span asp-validation-for="SellingPrice"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Reorder Level -->
                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="ReorderLevel"
                                       class="form-label fw-semibold">
                                    Reorder Level
                                </label>

                                <input asp-for="ReorderLevel"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="0" />

                                <span asp-validation-for="ReorderLevel"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted">
                                    Stock level at which the product needs attention.
                                </small>

                            </div>

                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="inventra-form-actions">

                        <a asp-action="Index"
                           class="btn btn-light border">
                            <i class="bi bi-x-lg me-1"></i>
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>
                            Save Product
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

</div>
