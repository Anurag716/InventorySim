@model ErrorViewModel

@{
ViewData["Title"] = "Error";
}

<div class="container-fluid mt-4">

<div class="row justify-content-center">

    <div class="col-12 col-md-9 col-lg-7">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center p-5">

                <!-- Error Icon -->

                <div class="d-inline-flex align-items-center justify-content-center
                            bg-danger-subtle text-danger rounded-circle mb-4"
                     style="width: 80px; height: 80px;">

                    <i class="bi bi-exclamation-triangle fs-1"></i>

                </div>


                <!-- Error Message -->

                <h2 class="fw-bold mb-2">
                    Something went wrong
                </h2>

                <p class="text-muted mb-4">
                    An unexpected error occurred while processing your request.
                    Please try again or return to the dashboard.
                </p>


                <!-- Request ID -->

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border rounded-3 text-start mb-4">

                        <div class="fw-semibold mb-1">
                            <i class="bi bi-info-circle me-1"></i>
                            Request ID
                        </div>

                        <code>@Model.RequestId</code>

                    </div>
                }


                <!-- Dashboard -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-speedometer2 me-2"></i>
                    Go to Dashboard

                </a>

            </div>

        </div>


        <!-- Development Information -->

        <div class="alert alert-warning border-0 rounded-4 mt-4">

            <div class="d-flex align-items-start">

                <i class="bi bi-code-slash fs-4 me-3"></i>

                <div>

                    <h6 class="fw-bold mb-2">
                        Development Information
                    </h6>

                    <p class="small mb-2">
                        Detailed error information is available when the application
                        is running in the Development environment.
                    </p>

                    <p class="small mb-0">
                        The Development environment should not be enabled for deployed
                        applications because detailed exception information may expose
                        sensitive data.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


</div>
