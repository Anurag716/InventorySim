<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Inventra</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/WebApplication1.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm inventra-navbar">

            <div class="container-fluid px-3 px-md-4">

                <!-- Brand -->
                <a class="navbar-brand fw-bold inventra-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-box-seam me-2"></i>
                    Inventra

                </a>


                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <!-- ================= NAVIGATION ================= -->

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                            <!-- Dashboard -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard

                                </a>

                            </li>


                            <!-- ================= ADMIN ================= -->

                            @if (User.IsInRole("Admin"))
                            {

                                <!-- Inventory Dropdown -->
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        <i class="bi bi-box-seam me-1"></i>
                                        Inventory

                                    </a>

                                    <ul class="dropdown-menu shadow-sm">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Categories"
                                               asp-action="Index">

                                                <i class="bi bi-tags me-2"></i>
                                                Categories

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Suppliers"
                                               asp-action="Index">

                                                <i class="bi bi-truck me-2"></i>
                                                Suppliers

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Products"
                                               asp-action="Index">

                                                <i class="bi bi-box-seam me-2"></i>
                                                Products

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Purchases"
                                               asp-action="Index">

                                                <i class="bi bi-cart-plus me-2"></i>
                                                Purchases

                                            </a>
                                        </li>

                                    </ul>

                                </li>


                                <!-- Sales Dropdown -->
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                        <i class="bi bi-receipt me-1"></i>
                                        Sales

                                    </a>

                                    <ul class="dropdown-menu shadow-sm">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Customers"
                                               asp-action="Index">

                                                <i class="bi bi-people me-2"></i>
                                                Customers

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Sales"
                                               asp-action="Index">

                                                <i class="bi bi-receipt me-2"></i>
                                                Sales History

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Returns"
                                               asp-action="Index">

                                                <i class="bi bi-arrow-return-left me-2"></i>
                                                Returns

                                            </a>
                                        </li>

                                    </ul>

                                </li>
                               <!-- User Management-->
                                <li>
                                    <a class="nav-link"
                                       asp-controller="Users"
                                       asp-action="Index">
                                        <i class="bi bi-people me-2"></i>
                                        User Management
                                    </a>
                                </li>

                                <!-- Reports -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reports"
                                       asp-action="Index">

                                        <i class="bi bi-bar-chart-line me-1"></i>
                                        Reports

                                    </a>

                                </li>

                            }


                            <!-- ================= CASHIER ================= -->

                            @if (User.IsInRole("Cashier"))
                            {

                                <!-- Product Lookup -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Products"
                                       asp-action="Index">

                                        <i class="bi bi-search me-1"></i>
                                        Product Lookup

                                    </a>

                                </li>


                                <!-- New Sale -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Sales"
                                       asp-action="Create">

                                        <i class="bi bi-cart-check me-1"></i>
                                        New Sale

                                    </a>

                                </li>


                                <!-- Sales History -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Sales"
                                       asp-action="Index">

                                        <i class="bi bi-receipt me-1"></i>
                                        Sales History

                                    </a>

                                </li>


                                <!-- Returns -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Returns"
                                       asp-action="Index">

                                        <i class="bi bi-arrow-return-left me-1"></i>
                                        Returns

                                    </a>

                                </li>

                            }

                        </ul>


                        <!-- ================= USER MENU ================= -->

                        <div class="dropdown">

                            <button class="btn btn-dark user-menu-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <i class="bi bi-person-circle me-2"></i>

                                <span>
                                    @User.Identity?.Name
                                </span>

                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-primary ms-2">
                                        Admin
                                    </span>
                                }
                                else if (User.IsInRole("Cashier"))
                                {
                                    <span class="badge bg-success ms-2">
                                        Cashier
                                    </span>
                                }

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                <li>
                                    <div class="px-3 py-2">

                                        <div class="fw-semibold">
                                            @User.Identity?.Name
                                        </div>

                                        <small class="text-muted">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <span>Administrator</span>
                                            }
                                            else
                                            {
                                                <span>Cashier</span>
                                            }
                                        </small>

                                    </div>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    }

                </div>

            </div>

        </nav>

    </header>


    <!-- Main content -->

    <div class="container-fluid px-3 px-md-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->

    <footer class="border-top footer text-muted">

        <div class="container text-center">

            &copy; 2026 - Inventra

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>