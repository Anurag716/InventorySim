@model Inventory.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid px-0">

    <div class="row min-vh-100 g-0">

        <!-- Left Branding Section -->
        <div class="col-lg-6 d-none d-lg-flex bg-primary text-white align-items-center">

            <div class="w-100 px-5">

                <div class="text-center">

                    <div class="mb-4">
                        <i class="bi bi-box-seam display-1"></i>
                    </div>

                    <h1 class="display-4 fw-bold mb-3">
                        Welcome to Inventra
                    </h1>

                    <p class="lead opacity-75 mb-5">
                        Manage your inventory, sales, purchases,
                        products, and reports from one powerful system.
                    </p>

                </div>


                <!-- Feature highlights -->

                <div class="row g-3 mt-4">

                    <div class="col-md-6">

                        <div class="d-flex align-items-center
                                    bg-white bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-boxes fs-3 me-3"></i>

                            <div>
                                <div class="fw-semibold">
                                    Inventory
                                </div>

                                <small class="opacity-75">
                                    Track your stock
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="d-flex align-items-center
                                    bg-white bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-cart-check fs-3 me-3"></i>

                            <div>
                                <div class="fw-semibold">
                                    Sales
                                </div>

                                <small class="opacity-75">
                                    Manage transactions
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="d-flex align-items-center
                                    bg-white bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-truck fs-3 me-3"></i>

                            <div>
                                <div class="fw-semibold">
                                    Purchases
                                </div>

                                <small class="opacity-75">
                                    Manage suppliers
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="d-flex align-items-center
                                    bg-white bg-opacity-10
                                    rounded-3 p-3">

                            <i class="bi bi-bar-chart-line fs-3 me-3"></i>

                            <div>
                                <div class="fw-semibold">
                                    Reports
                                </div>

                                <small class="opacity-75">
                                    Understand your business
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Right Login Section -->
        <div class="col-lg-6 d-flex align-items-center bg-light">

            <div class="w-100 px-4 px-md-5">

                <div class="mx-auto" style="max-width: 430px;">

                    <!-- Mobile Logo -->

                    <div class="text-center d-lg-none mb-4">

                        <div class="text-primary mb-2">
                            <i class="bi bi-box-seam display-4"></i>
                        </div>

                        <h2 class="fw-bold">
                            Inventra
                        </h2>

                    </div>


                    <!-- Login Card -->

                    <div class="card border-0 shadow-lg rounded-4">

                        <div class="card-body p-4 p-md-5">

                            <div class="text-center mb-4">

                                <div class="text-primary mb-3">
                                    <i class="bi bi-person-circle fs-1"></i>
                                </div>

                                <h2 class="fw-bold mb-2">
                                    Sign in
                                </h2>

                                <p class="text-muted mb-0">
                                    Enter your credentials to access Inventra.
                                </p>

                            </div>


                            <form asp-action="Login"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <!-- Validation -->

                                <div asp-validation-summary="ModelOnly"
                                     class="alert alert-danger py-2"
                                     role="alert">
                                </div>


                                <!-- Username -->

                                <div class="mb-3">

                                    <label asp-for="Username"
                                           class="form-label fw-semibold">

                                        Username

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-white">
                                            <i class="bi bi-person"></i>
                                        </span>

                                        <input asp-for="Username"
                                               class="form-control"
                                               placeholder="Enter your username"
                                               autocomplete="username" />

                                    </div>

                                    <span asp-validation-for="Username"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <!-- Password -->

                                <div class="mb-4">

                                    <label asp-for="Password"
                                           class="form-label fw-semibold">

                                        Password

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-white">
                                            <i class="bi bi-lock"></i>
                                        </span>

                                        <input asp-for="Password"
                                               id="passwordInput"
                                               type="password"
                                               class="form-control"
                                               placeholder="Enter your password"
                                               autocomplete="current-password" />

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="togglePassword"
                                                aria-label="Show password">

                                            <i class="bi bi-eye"
                                               id="passwordIcon"></i>

                                        </button>

                                    </div>

                                    <span asp-validation-for="Password"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <!-- Login Button -->

                                <button type="submit"
                                        class="btn btn-primary btn-lg w-100">

                                    <i class="bi bi-box-arrow-in-right me-2"></i>
                                    Login

                                </button>

                            </form>


                            <!-- Back to Home -->

                            <div class="text-center mt-4">

                                <a asp-controller="Account"
                                   asp-action="Index"
                                   class="text-decoration-none">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back to Home

                                </a>

                            </div>

                        </div>

                    </div>


                    <p class="text-center text-muted small mt-4 mb-0">
                        &copy; 2026 Inventra
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const passwordInput =
            document.getElementById("passwordInput");

        const togglePassword =
            document.getElementById("togglePassword");

        const passwordIcon =
            document.getElementById("passwordIcon");


        togglePassword.addEventListener("click", function () {

            const isPassword =
                passwordInput.type === "password";

            passwordInput.type =
                isPassword ? "text" : "password";

            passwordIcon.classList.toggle(
                "bi-eye",
                !isPassword
            );

            passwordIcon.classList.toggle(
                "bi-eye-slash",
                isPassword
            );

            togglePassword.setAttribute(
                "aria-label",
                isPassword
                    ? "Hide password"
                    : "Show password"
            );

        });

    </script>
}
