@{
    ViewData["Title"] = "Welcome";
}

<div class="container py-5">

    <!-- Hero Section -->
    <div class="row align-items-center min-vh-75">

        <div class="col-lg-7">

            <div class="mb-4">
                <span class="badge bg-primary px-3 py-2">
                    <i class="bi bi-box-seam me-1"></i>
                    Inventory Management System
                </span>
            </div>

            <h1 class="display-3 fw-bold mb-3">
                Welcome to <span class="text-primary">Inventra</span>
            </h1>

            <p class="lead text-muted mb-4">
                A simple and efficient inventory management system designed
                to help businesses manage products, stock, purchases, sales,
                customers, and returns in one place.
            </p>

            <div class="d-flex gap-3 flex-wrap">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary btn-lg px-4">

                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Get Started

                </a>

            </div>

        </div>


        <!-- Illustration / Feature Area -->
        <div class="col-lg-5 mt-5 mt-lg-0">

            <div class="card border-0 shadow-lg">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <div class="display-1 text-primary">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <h3 class="fw-bold mt-3">
                            Manage Everything
                        </h3>

                        <p class="text-muted">
                            Keep your inventory operations organized
                            and accessible from one system.
                        </p>

                    </div>


                    <div class="row g-3">

                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-boxes text-primary fs-3"></i>
                                <div class="fw-semibold mt-2">
                                    Products
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-bar-chart-line text-success fs-3"></i>
                                <div class="fw-semibold mt-2">
                                    Reports
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-cart-check text-warning fs-3"></i>
                                <div class="fw-semibold mt-2">
                                    Sales
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-arrow-repeat text-danger fs-3"></i>
                                <div class="fw-semibold mt-2">
                                    Returns
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Features -->
    <div class="row text-center mt-5 pt-5">

        <div class="col-md-4 mb-4">

            <i class="bi bi-boxes display-5 text-primary"></i>

            <h4 class="mt-3">
                Inventory Control
            </h4>

            <p class="text-muted">
                Monitor products, stock levels, categories,
                suppliers, and inventory movements.
            </p>

        </div>


        <div class="col-md-4 mb-4">

            <i class="bi bi-cart-check display-5 text-primary"></i>

            <h4 class="mt-3">
                Sales & Purchases
            </h4>

            <p class="text-muted">
                Manage purchases, point-of-sale transactions,
                payments, invoices, and returns.
            </p>

        </div>


        <div class="col-md-4 mb-4">

            <i class="bi bi-graph-up display-5 text-primary"></i>

            <h4 class="mt-3">
                Reports
            </h4>

            <p class="text-muted">
                View useful business information through
                sales, income, customer, product, and inventory reports.
            </p>

        </div>

    </div>

</div>