@model IEnumerable<Inventory.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">

    
    <!-- Page Header -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="d-flex align-items-center justify-content-center
                bg-primary-subtle text-primary rounded-3"
                 style="width: 52px; height: 52px;">

                <i class="bi bi-people fs-4"></i>

            </div>

            <div>

                <h2 class="mb-1 fw-bold">
                    User Management
                </h2>

                <p class="text-muted mb-0">
                    Manage Inventra users and Cashier accounts.
                </p>

            </div>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-person-plus me-1"></i>
            Add Cashier

        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- User Table -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                User
                            </th>

                            <th>
                                Username
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end pe-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                var isAdmin =
                                    user.Role?.RoleName == "Admin";

                                <tr>

                                    <!-- User -->

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center
                                                justify-content-center
                                                @(isAdmin
                                                    ? "bg-primary-subtle text-primary"
                                                    : "bg-success-subtle text-success")
                                                rounded-circle"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi @(isAdmin
                                                                                                   ? "bi-shield-check"
                                                                                                   : "bi-person")">
                                                </i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @user.FullName
                                                </div>

                                                <small class="text-muted">
                                                    Created
                                                    @user.CreatedAt.ToString("dd MMM yyyy")
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Username -->

                                    <td>
                                        <span class="fw-semibold">
                                            @user.Username
                                        </span>
                                    </td>


                                    <!-- Role -->

                                    <td>

                                        @if (isAdmin)
                                        {
                                            <span class="badge bg-primary-subtle
                                                text-primary">
                                                <i class="bi bi-shield-check me-1"></i>
                                                Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle
                                                text-info-emphasis">
                                                <i class="bi bi-person-badge me-1"></i>
                                                Cashier
                                            </span>
                                        }

                                    </td>


                                    <!-- Email -->

                                    <td>
                                        @user.Email
                                    </td>


                                    <!-- Phone -->

                                    <td>
                                        @(string.IsNullOrWhiteSpace(user.Phone)
                                            ? "—"
                                            : user.Phone)
                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (user.IsActive == true)
                                        {
                                            <span class="badge bg-success-subtle
                                                text-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle
                                                text-secondary">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end
                                            gap-2">

                                            <!-- Details -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    onclick="showUserDetails(@user.UserId)">

                                                <i class="bi bi-eye me-1"></i>
                                                View

                                            </button>


                                            @if (!isAdmin)
                                            {
                                                <!-- Edit -->

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        onclick="showEditUser(@user.UserId)">

                                                    <i class="bi bi-pencil me-1"></i>
                                                    Edit

                                                </button>

                                                <!-- Change Password -->

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning"
                                                        onclick="showChangePassword(@user.UserId)">

                                                    <i class="bi bi-key me-1"></i>
                                                    Change Password

                                                </button>

                                                <!-- Activate / Deactivate -->

                                                <form asp-action="ToggleStatus"
                                                      asp-route-id="@user.UserId"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    @if (user.IsActive == true)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Deactivate cashier"
                                                                onclick="return confirm('Are you sure you want to deactivate this cashier account?');">

                                                            <i class="bi bi-person-slash"></i>
                                                            Deactivate

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Activate cashier"
                                                                onclick="return confirm('Are you sure you want to activate this cashier account?');">

                                                            <i class="bi bi-person-check"></i>

                                                        </button>
                                                    }

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-people fs-1 d-block mb-3"></i>

                                        <h5 class="fw-semibold">
                                            No users found
                                        </h5>

                                        <p class="mb-3">
                                            There are currently no users to display.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-person-plus me-1"></i>
                                            Add Cashier

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    

</div>

<!-- User Details Modal -->

<div class="modal fade"
     id="userDetailsModal"
     tabindex="-1"
     aria-labelledby="userDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="d-flex align-items-center
                        justify-content-center
                        bg-primary-subtle text-primary
                        rounded-circle"
                         style="width: 42px; height: 42px;">

                        <i class="bi bi-person-vcard"></i>

                    </div>

                    <div>

                        <h5 class="modal-title mb-0"
                            id="userDetailsModalLabel">

                            User Details

                        </h5>

                        <small class="text-muted">
                            Account information
                        </small>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="text-center mb-4">

                    <div class="d-flex align-items-center
                        justify-content-center
                        bg-primary-subtle text-primary
                        rounded-circle mx-auto mb-3"
                         style="width: 70px; height: 70px;">

                        <i class="bi bi-person fs-2"></i>

                    </div>

                    <h5 class="fw-bold mb-1"
                        id="detailsFullName">
                        —
                    </h5>

                    <span class="badge bg-info-subtle text-info-emphasis"
                          id="detailsRole">
                        —
                    </span>

                </div>


                <div class="row g-3">

                    <div class="col-6">

                        <small class="text-muted d-block">
                            Username
                        </small>

                        <span class="fw-semibold"
                              id="detailsUsername">
                            —
                        </span>

                    </div>


                    <div class="col-6">

                        <small class="text-muted d-block">
                            Status
                        </small>

                        <span id="detailsStatus">
                            —
                        </span>

                    </div>


                    <div class="col-12">

                        <small class="text-muted d-block">
                            Email
                        </small>

                        <span id="detailsEmail">
                            —
                        </span>

                    </div>


                    <div class="col-12">

                        <small class="text-muted d-block">
                            Phone
                        </small>

                        <span id="detailsPhone">
                            —
                        </span>

                    </div>


                    <div class="col-6">

                        <small class="text-muted d-block">
                            Created
                        </small>

                        <span id="detailsCreatedAt">
                            —
                        </span>

                    </div>


                    <div class="col-6">

                        <small class="text-muted d-block">
                            Last Updated
                        </small>

                        <span id="detailsUpdatedAt">
                            —
                        </span>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Close

                </button>

            </div>

        </div>

    </div>

</div>

<!-- Edit User Modal -->

<div class="modal fade"
     id="editUserModal"
     tabindex="-1"
     aria-labelledby="editUserModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="d-flex align-items-center
                        justify-content-center
                        bg-primary-subtle text-primary
                        rounded-circle"
                         style="width: 42px; height: 42px;">

                        <i class="bi bi-pencil-square"></i>

                    </div>

                    <div>

                        <h5 class="modal-title mb-0"
                            id="editUserModalLabel">

                            Edit Cashier

                        </h5>

                        <small class="text-muted">
                            Update Cashier account information
                        </small>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form id="editUserForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="editUserId"
                           name="UserId" />


                    <div class="row g-4">

                        <!-- Full Name -->

                        <div class="col-md-6">

                            <label for="editFullName"
                                   class="form-label fw-semibold">

                                Full Name

                            </label>

                            <input type="text"
                                   id="editFullName"
                                   name="FullName"
                                   class="form-control"
                                   required />

                            <div class="text-danger small"
                                 id="editFullNameError">
                            </div>

                        </div>


                        <!-- Username -->

                        <div class="col-md-6">

                            <label for="editUsername"
                                   class="form-label fw-semibold">

                                Username

                            </label>

                            <input type="text"
                                   id="editUsername"
                                   name="Username"
                                   class="form-control"
                                   required />

                            <div class="text-danger small"
                                 id="editUsernameError">
                            </div>

                        </div>


                        <!-- Email -->

                        <div class="col-md-6">

                            <label for="editEmail"
                                   class="form-label fw-semibold">

                                Email

                            </label>

                            <input type="email"
                                   id="editEmail"
                                   name="Email"
                                   class="form-control"
                                   required />

                            <div class="text-danger small"
                                 id="editEmailError">
                            </div>

                        </div>


                        <!-- Phone -->

                        <div class="col-md-6">

                            <label for="editPhone"
                                   class="form-label fw-semibold">

                                Phone

                            </label>

                            <input type="text"
                                   id="editPhone"
                                   name="Phone"
                                   class="form-control" />

                            <div class="text-danger small"
                                 id="editPhoneError">
                            </div>

                        </div>

                    </div>


                    <div class="alert alert-info d-flex align-items-start gap-3
                        mt-4 mb-0">

                        <i class="bi bi-info-circle fs-5"></i>

                        <div>

                            <div class="fw-semibold">
                                Cashier Account
                            </div>

                            <div class="small">
                                Password and role are not changed from this form.
                                Use the appropriate account-management operation
                                for password changes.
                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Change Password Modal -->

<div class="modal fade"
     id="changePasswordModal"
     tabindex="-1"
     aria-labelledby="changePasswordModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="d-flex align-items-center
                        justify-content-center
                        bg-warning-subtle text-warning
                        rounded-circle"
                         style="width: 42px; height: 42px;">

                        <i class="bi bi-key"></i>

                    </div>

                    <div>

                        <h5 class="modal-title mb-0"
                            id="changePasswordModalLabel">

                            Change Password

                        </h5>

                        <small class="text-muted"
                               id="changePasswordUserName">

                            Cashier account

                        </small>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form id="changePasswordForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="changePasswordUserId"
                           name="UserId" />


                    <div class="alert alert-warning d-flex
                        align-items-start gap-2">

                        <i class="bi bi-shield-lock fs-5"></i>

                        <div class="small">

                            The existing password will be replaced with
                            the new password you enter below.

                        </div>

                    </div>


                    <!-- New Password -->

                    <div class="mb-3">

                        <label for="newPassword"
                               class="form-label fw-semibold">

                            New Password

                        </label>

                        <input type="password"
                               id="newPassword"
                               name="NewPassword"
                               class="form-control"
                               minlength="6"
                               required
                               autocomplete="new-password" />

                    </div>


                    <!-- Confirm Password -->

                    <div class="mb-3">

                        <label for="confirmPassword"
                               class="form-label fw-semibold">

                            Confirm Password

                        </label>

                        <input type="password"
                               id="confirmPassword"
                               name="ConfirmPassword"
                               class="form-control"
                               required
                               autocomplete="new-password" />

                        <div class="text-danger small"
                             id="passwordMismatchError">
                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-key me-1"></i>
                        Change Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // Change password form validation

        document.getElementById("changePasswordForm")
            .addEventListener("submit", function (event) {

                const newPassword =
                    document.getElementById("newPassword").value;

                const confirmPassword =
                    document.getElementById("confirmPassword").value;

                const error =
                    document.getElementById("passwordMismatchError");


                if (newPassword !== confirmPassword) {

                    event.preventDefault();

                    error.textContent =
                        "Passwords do not match.";

                }
                else {

                    error.textContent = "";

                }

            });


        // User details modal

        async function showUserDetails(userId) {

            try {

                const response =
                    await fetch(`/Users/Details/${userId}`);

                if (!response.ok) {

                    alert("Unable to load user details.");
                    return;

                }

                const user =
                    await response.json();


                // Basic information

                document.getElementById("detailsFullName")
                    .textContent = user.fullName;

                document.getElementById("detailsUsername")
                    .textContent = user.username;

                document.getElementById("detailsEmail")
                    .textContent = user.email;

                document.getElementById("detailsPhone")
                    .textContent =
                    user.phone || "Not provided";

                document.getElementById("detailsCreatedAt")
                    .textContent = user.createdAt;

                document.getElementById("detailsUpdatedAt")
                    .textContent =
                    user.updatedAt || "Never";


                // Role

                const roleElement =
                    document.getElementById("detailsRole");

                roleElement.textContent = user.role;


                if (user.role === "Admin") {

                    roleElement.className =
                        "badge bg-primary-subtle text-primary";

                }
                else {

                    roleElement.className =
                        "badge bg-info-subtle text-info-emphasis";

                }


                // Status

                const statusElement =
                    document.getElementById("detailsStatus");

                if (user.isActive === true) {

                    statusElement.innerHTML =
                        '<span class="badge bg-success-subtle text-success">' +
                        '<i class="bi bi-check-circle me-1"></i>' +
                        'Active' +
                        '</span>';

                }
                else {

                    statusElement.innerHTML =
                        '<span class="badge bg-secondary-subtle text-secondary">' +
                        '<i class="bi bi-x-circle me-1"></i>' +
                        'Inactive' +
                        '</span>';

                }


                // Open details modal

                const modalElement =
                    document.getElementById("userDetailsModal");

                const modal =
                    bootstrap.Modal.getOrCreateInstance(modalElement);

                modal.show();

            }
            catch (error) {

                console.error(error);

                alert(
                    "Something went wrong while loading user details."
                );

            }

        }


        // Edit user modal

        async function showEditUser(userId) {

            try {

                const response =
                    await fetch(`/Users/Edit/${userId}`);

                if (!response.ok) {

                    alert("Unable to load user information.");
                    return;

                }

                const user =
                    await response.json();


                // Fill form

                document.getElementById("editUserId")
                    .value = user.userId;

                document.getElementById("editFullName")
                    .value = user.fullName;

                document.getElementById("editUsername")
                    .value = user.username;

                document.getElementById("editEmail")
                    .value = user.email;

                document.getElementById("editPhone")
                    .value = user.phone || "";


                // Set POST action

                document.getElementById("editUserForm")
                    .action =
                    "/Users/Edit/" + user.userId;


                // Clear previous validation messages

                document.getElementById("editFullNameError")
                    .textContent = "";

                document.getElementById("editUsernameError")
                    .textContent = "";

                document.getElementById("editEmailError")
                    .textContent = "";

                document.getElementById("editPhoneError")
                    .textContent = "";


                // Open edit modal

                const modalElement =
                    document.getElementById("editUserModal");

                const modal =
                    bootstrap.Modal.getOrCreateInstance(modalElement);

                modal.show();

            }
            catch (error) {

                console.error(error);

                alert(
                    "Something went wrong while loading the user."
                );

            }

        }


        // Change password modal

        async function showChangePassword(userId) {

            try {

                const response =
                    await fetch(
                        "/Users/ChangePassword/" + userId
                    );

                if (!response.ok) {

                    alert("Unable to load cashier information.");
                    return;

                }

                const user =
                    await response.json();


                // Set user information

                document.getElementById("changePasswordUserId")
                    .value = user.userId;

                document.getElementById("changePasswordUserName")
                    .textContent =
                    user.fullName + " (@@" + user.username + ")"


                // Set form action

                document.getElementById("changePasswordForm")
                    .action =
                    "/Users/ChangePassword/" + user.userId;


                // Clear password fields

                document.getElementById("newPassword")
                    .value = "";

                document.getElementById("confirmPassword")
                    .value = "";

                document.getElementById("passwordMismatchError")
                    .textContent = "";


                // Open password modal

                const modalElement =
                    document.getElementById("changePasswordModal");

                const modal =
                    bootstrap.Modal.getOrCreateInstance(modalElement);

                modal.show();

            }
            catch (error) {

                console.error(error);

                alert(
                    "Something went wrong while loading the cashier."
                );

            }

        }

    </script>

}