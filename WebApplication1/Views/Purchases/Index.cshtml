@model IEnumerable<Inventory.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<div class="container mt-4">

    @* Success message *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @* Error message *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Purchases</h2>

        <a asp-action="Create"
           class="btn btn-primary">

            Add Purchase

        </a>

    </div>


    <table class="table table-bordered table-striped">

        <thead>

            <tr>

                <th>Purchase Number</th>

                <th>Supplier</th>

                <th>Purchase Date</th>

                <th>Status</th>

                <th>Total Amount</th>

                <th>Created By</th>

                <th>Actions</th>

            </tr>

        </thead>


        <tbody>

            @foreach (var purchase in Model)
            {
                <tr>

                    <td>
                        @purchase.PurchaseNumber
                    </td>


                    <td>
                        @purchase.Supplier.Name
                    </td>


                    <td>
                        @purchase.PurchaseDate.ToString("dd-MM-yyyy")
                    </td>


                    <td>

                        @if (purchase.Status == "Completed")
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @purchase.Status
                            </span>
                        }

                    </td>


                    <td>
                        ₹@purchase.TotalAmount.ToString("0.00")
                    </td>


                    <td>
                        @purchase.CreatedByUser.FullName
                    </td>


                    <td>

                        @* =========================
                           Details
                           ========================= *@

                        <button type="button"
                                class="btn btn-sm btn-info"
                                data-bs-toggle="modal"
                                data-bs-target="#purchaseDetailsModal-@purchase.PurchaseId">

                            Details

                        </button>


                        @* =========================
                           Draft Purchase Actions
                           ========================= *@

                        @if (purchase.Status == "Draft")
                        {
                            @* Edit *@

                            <a asp-action="Edit"
                               asp-route-id="@purchase.PurchaseId"
                               class="btn btn-sm btn-warning">

                                Edit

                            </a>


                            @* Complete *@

                            <button type="button"
                                    class="btn btn-sm btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#completePurchaseModal-@purchase.PurchaseId">

                                Complete

                            </button>


                            @* Delete *@

                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deletePurchaseModal-@purchase.PurchaseId">

                                Delete

                            </button>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- =========================================================
     Purchase Details Modals
     ========================================================= -->

@foreach (var purchase in Model)
{
    <div class="modal fade"
         id="purchaseDetailsModal-@purchase.PurchaseId"
         tabindex="-1"
         aria-labelledby="purchaseDetailsLabel-@purchase.PurchaseId"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">


                <!-- Modal Header -->

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="purchaseDetailsLabel-@purchase.PurchaseId">

                        Purchase Details

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- Modal Body -->

                <div class="modal-body">

                    <div class="row mb-3">

                        <div class="col-md-6">

                            <strong>Purchase Number:</strong>

                            <div>
                                @purchase.PurchaseNumber
                            </div>

                        </div>


                        <div class="col-md-6">

                            <strong>Supplier:</strong>

                            <div>
                                @purchase.Supplier.Name
                            </div>

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-md-6">

                            <strong>Purchase Date:</strong>

                            <div>
                                @purchase.PurchaseDate.ToString("dd-MM-yyyy")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <strong>Status:</strong>

                            <div>
                                @purchase.Status
                            </div>

                        </div>

                    </div>


                    <div class="row mb-4">

                        <div class="col-md-6">

                            <strong>Created By:</strong>

                            <div>
                                @purchase.CreatedByUser.FullName
                            </div>

                        </div>


                        <div class="col-md-6">

                            <strong>Total Amount:</strong>

                            <div>
                                ₹@purchase.TotalAmount.ToString("0.00")
                            </div>

                        </div>

                    </div>


                    <h6 class="mb-3">
                        Purchased Products
                    </h6>


                    <div class="table-responsive">

                        <table class="table table-bordered table-sm">

                            <thead>

                                <tr>

                                    <th>Product</th>

                                    <th>SKU</th>

                                    <th>Quantity</th>

                                    <th>Unit Price</th>

                                    <th>Subtotal</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in purchase.Purchaseitems)
                                {
                                    <tr>

                                        <td>
                                            @item.Product.Name
                                        </td>

                                        <td>
                                            @item.Product.Sku
                                        </td>

                                        <td>
                                            @item.Quantity
                                        </td>

                                        <td>
                                            ₹@item.UnitPrice.ToString("0.00")
                                        </td>

                                        <td>
                                            ₹@item.Subtotal.ToString("0.00")
                                        </td>

                                    </tr>
                                }

                            </tbody>


                            <tfoot>

                                <tr>

                                    <th colspan="4"
                                        class="text-end">

                                        Total

                                    </th>

                                    <th>

                                        ₹@purchase.TotalAmount.ToString("0.00")

                                    </th>

                                </tr>

                            </tfoot>

                        </table>

                    </div>

                </div>


                <!-- Modal Footer -->

                <div class="modal-footer">

                    @if (purchase.Status == "Draft")
                    {
                        <a asp-action="Edit"
                           asp-route-id="@purchase.PurchaseId"
                           class="btn btn-warning">

                            Edit

                        </a>


                        <button type="button"
                                class="btn btn-success"
                                data-bs-toggle="modal"
                                data-bs-target="#completePurchaseModal-@purchase.PurchaseId"
                                data-bs-dismiss="modal">

                            Complete Purchase

                        </button>


                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deletePurchaseModal-@purchase.PurchaseId"
                                data-bs-dismiss="modal">

                            Delete

                        </button>
                    }


                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Close

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Complete Purchase Confirmation Modal
         ===================================================== -->

    @if (purchase.Status == "Draft")
    {
        <div class="modal fade"
             id="completePurchaseModal-@purchase.PurchaseId"
             tabindex="-1"
             aria-labelledby="completePurchaseLabel-@purchase.PurchaseId"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">


                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="completePurchaseLabel-@purchase.PurchaseId">

                            Confirm Purchase Completion

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p class="mb-3">
                            Are you sure you want to complete this purchase?
                        </p>

                        <div class="alert alert-warning mb-0">

                            <strong>Purchase:</strong>
                            @purchase.PurchaseNumber

                            <br />

                            <strong>Total Amount:</strong>
                            ₹@purchase.TotalAmount.ToString("0.00")

                            <br /><br />

                            Completing this purchase will increase the
                            product stock and create inventory transactions.

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <form asp-action="Complete"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@purchase.PurchaseId" />

                            <button type="submit"
                                    class="btn btn-success">

                                Complete Purchase

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         Delete Purchase Confirmation Modal
         ===================================================== -->

    @if (purchase.Status == "Draft")
    {
        <div class="modal fade"
             id="deletePurchaseModal-@purchase.PurchaseId"
             tabindex="-1"
             aria-labelledby="deletePurchaseLabel-@purchase.PurchaseId"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">


                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="deletePurchaseLabel-@purchase.PurchaseId">

                            Confirm Purchase Deletion

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p class="mb-3">

                            Are you sure you want to delete this purchase?

                        </p>


                        <div class="alert alert-danger mb-0">

                            <strong>Purchase:</strong>
                            @purchase.PurchaseNumber

                            <br />

                            <strong>Total Amount:</strong>
                            ₹@purchase.TotalAmount.ToString("0.00")

                            <br /><br />

                            This action cannot be undone.

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <form asp-action="Delete"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@purchase.PurchaseId" />

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete Purchase

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

}