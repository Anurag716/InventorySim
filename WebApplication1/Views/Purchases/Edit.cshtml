@model Inventory.ViewModels.PurchaseEditViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Edit Purchase";

    var productData = Model.Products.Select(product => new
    {
        value = product.ProductId,
        text = product.ProductName + " (" + product.Sku + ")",
        purchasePrice = product.PurchasePrice
    });
}


<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">

        <div>
            <h2>Edit Purchase</h2>
            <p>
                Update supplier purchase details and modify the products received.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Purchases
        </a>

    </div>


    <!-- Purchase Form -->
    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <div class="inventra-form-section">

                <!-- Section Header -->
                <div class="inventra-form-section-header">

                    <div>
                        <h5 class="mb-1">Purchase Information</h5>
                        <p class="text-muted mb-0">
                            Update the supplier, purchase date, and purchased products.
                        </p>
                    </div>

                </div>


                <!-- Section Body -->
                <div class="inventra-form-section-body">

                    <form asp-action="Edit"
                          method="post"
                          id="purchaseForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="PurchaseId" />

                        <input type="hidden"
                               asp-for="PurchaseNumber" />


                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- JavaScript Warning -->
                        <div id="itemErrorMessage"
                             class="alert alert-warning alert-dismissible fade show d-none"
                             role="alert">

                            <strong>Cannot remove product.</strong>
                            A purchase must contain at least one product.

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>


                        <!-- Purchase Details -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Purchase Number
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.PurchaseNumber"
                                       readonly />

                            </div>


                            <div class="col-md-6">

                                <label asp-for="SupplierId"
                                       class="form-label">
                                    Supplier
                                </label>

                                <select asp-for="SupplierId"
                                        asp-items="Model.Suppliers"
                                        class="form-select">

                                    <option value="">
                                        -- Select Supplier --
                                    </option>

                                </select>

                                <span asp-validation-for="SupplierId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="PurchaseDate"
                                       class="form-label">
                                    Purchase Date
                                </label>

                                <input asp-for="PurchaseDate"
                                       class="form-control" />

                                <span asp-validation-for="PurchaseDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- Purchased Products Header -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>
                                <h5 class="mb-1">
                                    Purchased Products
                                </h5>

                                <p class="text-muted mb-0 small">
                                    Modify quantities, prices, or add additional products.
                                </p>
                            </div>

                            <button type="button"
                                    id="addItemButton"
                                    class="btn btn-primary">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Product

                            </button>

                        </div>


                        <!-- Product Rows -->
                        <div id="itemsContainer">

                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="purchase-item inventra-purchase-item">

                                    <div class="row g-3 align-items-end">

                                        <input type="hidden"
                                               name="Items[@i].PurchaseItemId"
                                               value="@Model.Items[i].PurchaseItemId" />


                                        <!-- Product -->
                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Product
                                            </label>

                                            <select name="Items[@i].ProductId"
                                                    class="form-select product-select">

                                                <option value="">
                                                    -- Select Product --
                                                </option>

                                                @foreach (var product in Model.Products)
                                                {
                                                    if (product.ProductId == Model.Items[i].ProductId)
                                                    {
                                                        <option value="@product.ProductId"
                                                                data-purchase-price="@product.PurchasePrice"
                                                                selected>

                                                            @product.ProductName
                                                            (@product.Sku)

                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@product.ProductId"
                                                                data-purchase-price="@product.PurchasePrice">

                                                            @product.ProductName
                                                            (@product.Sku)

                                                        </option>
                                                    }
                                                }

                                            </select>

                                        </div>


                                        <!-- Quantity -->
                                        <div class="col-md-2">

                                            <label class="form-label">
                                                Quantity
                                            </label>

                                            <input type="number"
                                                   name="Items[@i].Quantity"
                                                   class="form-control quantity-input"
                                                   min="1"
                                                   value="@Model.Items[i].Quantity" />

                                        </div>


                                        <!-- Unit Price -->
                                        <div class="col-md-3">

                                            <label class="form-label">
                                                Unit Price
                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    ₹
                                                </span>

                                                <input type="number"
                                                       name="Items[@i].UnitPrice"
                                                       class="form-control price-input"
                                                       min="0.01"
                                                       step="0.01"
                                                       value="@Model.Items[i].UnitPrice.ToString("0.00")" />

                                            </div>

                                        </div>


                                        <!-- Subtotal -->
                                        <div class="col-md-2">

                                            <label class="form-label">
                                                Subtotal
                                            </label>

                                            <input type="text"
                                                   class="form-control subtotal-input"
                                                   value="@((Model.Items[i].Quantity * Model.Items[i].UnitPrice).ToString("0.00"))"
                                                   readonly />

                                        </div>


                                        <!-- Remove -->
                                        <div class="col-md-1">

                                            <button type="button"
                                                    class="btn btn-outline-danger remove-item w-100"
                                                    title="Remove product">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>


                        <!-- Total -->
                        <div class="purchase-total">

                            <div>
                                <span class="text-muted">
                                    Total Purchase Amount
                                </span>
                            </div>

                            <div class="purchase-total-amount"
                                 id="totalAmount">
                                ₹0.00
                            </div>

                        </div>


                        <!-- Actions -->
                        <div class="inventra-form-actions">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let itemIndex = @Model.Items.Count;

        const products =
            @Html.Raw(JsonSerializer.Serialize(productData));

        const itemsContainer =
            document.getElementById("itemsContainer");

        const addItemButton =
            document.getElementById("addItemButton");

        const totalAmount =
            document.getElementById("totalAmount");

        const itemErrorMessage =
            document.getElementById("itemErrorMessage");


        // Calculate total amount

        function updateTotal() {

            let total = 0;

            const rows =
                document.querySelectorAll(".purchase-item");

            rows.forEach(function (row) {

                const quantity =
                    parseFloat(
                        row.querySelector(".quantity-input").value
                    ) || 0;

                const price =
                    parseFloat(
                        row.querySelector(".price-input").value
                    ) || 0;

                const subtotal =
                    quantity * price;

                row.querySelector(".subtotal-input").value =
                    subtotal.toFixed(2);

                total += subtotal;

            });

            totalAmount.textContent =
                "₹" + total.toFixed(2);
        }


        // Re-index all product rows
        // This keeps ASP.NET Core model binding correct.

        function reindexItems() {

            const rows =
                document.querySelectorAll(".purchase-item");

            rows.forEach(function (row, index) {

                const purchaseItemId =
                    row.querySelector(
                        'input[name*=".PurchaseItemId"]'
                    );

                const productSelect =
                    row.querySelector(".product-select");

                const quantityInput =
                    row.querySelector(".quantity-input");

                const priceInput =
                    row.querySelector(".price-input");


                if (purchaseItemId) {

                    purchaseItemId.name =
                        `Items[${index}].PurchaseItemId`;

                }


                productSelect.name =
                    `Items[${index}].ProductId`;

                quantityInput.name =
                    `Items[${index}].Quantity`;

                priceInput.name =
                    `Items[${index}].UnitPrice`;

            });

            itemIndex = rows.length;
        }


        // Show Bootstrap warning

        function showItemError() {

            itemErrorMessage.classList.remove("d-none");

            // Automatically hide after 4 seconds

            setTimeout(function () {

                itemErrorMessage.classList.add("d-none");

            }, 4000);
        }


        // Add new product row

        addItemButton.addEventListener(
            "click",
            function () {

                let options =
                    '<option value="">-- Select Product --</option>';

                products.forEach(function (product) {

                    options +=
                        `<option value="${product.value}"
                                 data-purchase-price="${product.purchasePrice}">
                            ${product.text}
                         </option>`;

                });


                const row =
                    document.createElement("div");

               row.className =
    "purchase-item inventra-purchase-item";


                row.innerHTML = `

                    <div class="row align-items-end">

                        <input type="hidden"
                               name="Items[${itemIndex}].PurchaseItemId"
                               value="0" />

                        <div class="col-md-4">

                            <label class="form-label">
                                Product
                            </label>

                            <select name="Items[${itemIndex}].ProductId"
                                    class="form-select product-select">

                                ${options}

                            </select>

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input type="number"
                                   name="Items[${itemIndex}].Quantity"
                                   class="form-control quantity-input"
                                   min="1"
                                   value="1" />

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Unit Price
                            </label>

                            <input type="number"
                                   name="Items[${itemIndex}].UnitPrice"
                                   class="form-control price-input"
                                   min="0.01"
                                   step="0.01"
                                   value="0.00" />

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Subtotal
                            </label>

                            <input type="text"
                                   class="form-control subtotal-input"
                                   value="0.00"
                                   readonly />

                        </div>

                        <div class="col-md-1">

                           <button type="button"
        class="btn btn-outline-danger remove-item w-100"
        title="Remove product">

    <i class="bi bi-trash"></i>

</button>

                        </div>

                    </div>
                `;


                itemsContainer.appendChild(row);

                itemIndex++;

                updateTotal();

                reindexItems();
            }
        );


        // Product selection

        itemsContainer.addEventListener(
            "change",
            function (event) {

                if (
                    event.target.classList.contains(
                        "product-select"
                    )
                ) {

                    const selectedOption =
                        event.target.options[
                            event.target.selectedIndex
                        ];

                    const purchasePrice =
                        selectedOption.dataset.purchasePrice;

                    const row =
                        event.target.closest(
                            ".purchase-item"
                        );

                    const priceInput =
                        row.querySelector(
                            ".price-input"
                        );

                    if (
                        purchasePrice !== undefined &&
                        purchasePrice !== ""
                    ) {

                        priceInput.value =
                            parseFloat(
                                purchasePrice
                            ).toFixed(2);

                    }

                    updateTotal();
                }
            }
        );


        // Quantity and price changes

        itemsContainer.addEventListener(
            "input",
            function (event) {

                if (
                    event.target.classList.contains(
                        "quantity-input"
                    ) ||
                    event.target.classList.contains(
                        "price-input"
                    )
                ) {

                    updateTotal();
                }
            }
        );


        // Remove product row

        itemsContainer.addEventListener(
            "click",
            function (event) {

                if (
                    event.target.classList.contains(
                        "remove-item"
                    )
                ) {

                    const rows =
                        document.querySelectorAll(
                            ".purchase-item"
                        );


                    // A purchase must always have
                    // at least one product.

                    if (rows.length <= 1) {

                        showItemError();

                        return;
                    }


                    event.target
                        .closest(".purchase-item")
                        .remove();


                    // Re-index after removing a row

                    reindexItems();

                    updateTotal();
                }
            }
        );


        // Initial setup

        reindexItems();

        updateTotal();

    </script>
}

