@model Inventory.ViewModels.PurchaseCreateViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Create Purchase";

    var productData = Model.Products.Select(product => new
    {
        value = product.ProductId,
        text = product.ProductName + " (" + product.Sku + ")",
        purchasePrice = product.PurchasePrice
    });
}

<div class="container-fluid mt-4">


<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">

    <div>
        <h2>Create Purchase</h2>
        <p>Record a supplier purchase and add the received products to inventory.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Purchases
    </a>

</div>

<!-- Purchase Form -->
<div class="row justify-content-center">

    <div class="col-12 col-xl-10">

        <div class="inventra-form-section">

            <!-- Purchase Information -->
            <div class="inventra-form-section-header">
                <h5 class="mb-1">Purchase Information</h5>
                <p class="text-muted mb-0">
                    Select the supplier and purchase date.
                </p>
            </div>

            <div class="inventra-form-section-body">

                <form asp-action="Create"
                      method="post"
                      id="purchaseForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <!-- Supplier -->
                        <div class="col-12 col-md-6 mb-3">

                            <label asp-for="SupplierId"
                                   class="form-label fw-semibold">
                                Supplier
                            </label>

                            <select asp-for="SupplierId"
                                    asp-items="Model.Suppliers"
                                    class="form-select">

                                <option value="">
                                    -- Select Supplier --
                                </option>

                            </select>

                            <span asp-validation-for="SupplierId"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Purchase Date -->
                        <div class="col-12 col-md-6 mb-3">

                            <label asp-for="PurchaseDate"
                                   class="form-label fw-semibold">
                                Purchase Date
                            </label>

                            <input asp-for="PurchaseDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="PurchaseDate"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                    <hr class="my-4">

                    <!-- Purchase Items Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h5 class="fw-semibold mb-1">
                                Purchase Items
                            </h5>

                            <p class="text-muted mb-0 small">
                                Add the products and quantities received from the supplier.
                            </p>
                        </div>

                        <button type="button"
                                id="addItemButton"
                                class="btn btn-primary">

                            <i class="bi bi-plus-lg me-1"></i>
                            Add Product

                        </button>

                    </div>

                    <!-- Product Rows -->
                    <div id="itemsContainer">

                        @if (Model.Items != null && Model.Items.Count > 0)
                        {
                            for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="purchase-item inventra-purchase-item">

                                    <div class="row align-items-end">

                                        <!-- Product -->
                                        <div class="col-12 col-md-5 mb-3">

                                            <label class="form-label fw-semibold">
                                                Product
                                            </label>

                                            <select name="Items[@i].ProductId"
                                                    class="form-select product-select">

                                                <option value="">
                                                    -- Select Product --
                                                </option>

                                                @foreach (var product in Model.Products)
                                                {
                                                    <option value="@product.ProductId"
                                                            data-purchase-price="@product.PurchasePrice"
                                                            selected="@(product.ProductId == Model.Items[i].ProductId)">

                                                        @product.ProductName (@product.Sku)

                                                    </option>
                                                }

                                            </select>

                                        </div>

                                        <!-- Quantity -->
                                        <div class="col-12 col-sm-6 col-md-2 mb-3">

                                            <label class="form-label fw-semibold">
                                                Quantity
                                            </label>

                                            <input type="number"
                                                   name="Items[@i].Quantity"
                                                   value="@Model.Items[i].Quantity"
                                                   min="1"
                                                   class="form-control quantity-input" />

                                        </div>

                                        <!-- Unit Price -->
                                        <div class="col-12 col-sm-6 col-md-3 mb-3">

                                            <label class="form-label fw-semibold">
                                                Unit Price
                                            </label>

                                            <div class="input-group">

                                                <span class="input-group-text">
                                                    ₹
                                                </span>

                                                <input type="number"
                                                       name="Items[@i].UnitPrice"
                                                       value="@Model.Items[i].UnitPrice"
                                                       min="0.01"
                                                       step="0.01"
                                                       class="form-control price-input" />

                                            </div>

                                            <small class="text-muted">
                                                Filled from purchase price.
                                            </small>

                                        </div>

                                        <!-- Remove -->
                                        <div class="col-12 col-md-2 mb-3">

                                            <button type="button"
                                                    class="btn btn-outline-danger remove-item w-100">

                                                <i class="bi bi-trash me-1"></i>
                                                Remove

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                    <!-- Total -->
                    <div class="purchase-total">

                        <div>
                            <span class="text-muted">
                                Purchase Total
                            </span>
                        </div>

                        <div class="purchase-total-amount">
                            ₹<span id="grandTotal">0.00</span>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="inventra-form-actions">

                        <a asp-action="Index"
                           class="btn btn-light border">
                            <i class="bi bi-x-lg me-1"></i>
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-success px-4">

                            <i class="bi bi-check-lg me-1"></i>
                            Save Purchase

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


</div>

<script>

    let itemIndex = @Model.Items.Count;


    // Product information supplied by the server.
    const products =
        @Html.Raw(JsonSerializer.Serialize(productData));


    const itemsContainer =
        document.getElementById("itemsContainer");

    const addItemButton =
        document.getElementById("addItemButton");

    const grandTotal =
        document.getElementById("grandTotal");

    const purchaseForm =
        document.getElementById("purchaseForm");


    // Add new product row
    addItemButton.addEventListener("click", function () {

        addItemRow();

    });


    // Create a new purchase item row
    function addItemRow() {

        let productOptions =
            '<option value="">-- Select Product --</option>';


        products.forEach(function (product) {

            productOptions +=
                `<option
                    value="${product.value}"
                    data-purchase-price="${product.purchasePrice}">
                    ${product.text}
                </option>`;

        });


        const row =
            document.createElement("div");


        row.className =
            "purchase-item border rounded p-3 mb-3";


        row.innerHTML = `

            <div class="row">

                <!-- Product -->

                <div class="col-md-5 mb-3">

                    <label class="form-label">
                        Product
                    </label>

                    <select
                        name="Items[${itemIndex}].ProductId"
                        class="form-select product-select">

                        ${productOptions}

                    </select>

                </div>


                <!-- Quantity -->

                <div class="col-md-2 mb-3">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input
                        type="number"
                        name="Items[${itemIndex}].Quantity"
                        min="1"
                        value="1"
                        class="form-control quantity-input" />

                </div>


                <!-- Unit Price -->

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Unit Price
                    </label>

                    <input
                        type="number"
                        name="Items[${itemIndex}].UnitPrice"
                        min="0.01"
                        step="0.01"
                        class="form-control price-input" />

                    <small class="text-muted">
                        Automatically filled from product purchase price.
                        You can change it if needed.
                    </small>

                </div>


                <!-- Remove -->

                <div class="col-md-2 mb-3 d-flex align-items-end">

                    <button
                        type="button"
                        class="btn btn-danger remove-item w-100">

                        Remove

                    </button>

                </div>

            </div>

        `;


        itemsContainer.appendChild(row);

        itemIndex++;

        updateTotal();

    }


    // When product changes,
    // automatically fill Unit Price.
    itemsContainer.addEventListener(
        "change",
        function (event) {

            if (
                event.target.classList.contains(
                    "product-select"
                )
            ) {

                const selectedOption =
                    event.target.options[
                        event.target.selectedIndex
                    ];


                const purchasePrice =
                    selectedOption.dataset.purchasePrice;


                const row =
                    event.target.closest(
                        ".purchase-item"
                    );


                const priceInput =
                    row.querySelector(
                        ".price-input"
                    );


                if (
                    purchasePrice !== undefined &&
                    purchasePrice !== ""
                ) {

                    priceInput.value =
                        parseFloat(
                            purchasePrice
                        ).toFixed(2);

                }
                else {

                    priceInput.value = "";

                }


                updateTotal();

            }

        }
    );


    // Remove product row
    itemsContainer.addEventListener(
        "click",
        function (event) {

            if (
                event.target.classList.contains(
                    "remove-item"
                )
            ) {

                event.target
                    .closest(".purchase-item")
                    .remove();

                updateTotal();

            }

        }
    );


    // Calculate total when quantity or price changes.
    itemsContainer.addEventListener(
        "input",
        function (event) {

            if (
                event.target.classList.contains(
                    "quantity-input"
                ) ||
                event.target.classList.contains(
                    "price-input"
                )
            ) {

                updateTotal();

            }

        }
    );


    // Calculate purchase total
    function updateTotal() {

        let total = 0;


        const rows =
            document.querySelectorAll(
                ".purchase-item"
            );


        rows.forEach(function (row) {

            const quantity =
                parseFloat(
                    row.querySelector(
                        ".quantity-input"
                    )?.value
                ) || 0;


            const price =
                parseFloat(
                    row.querySelector(
                        ".price-input"
                    )?.value
                ) || 0;


            total +=
                quantity * price;

        });


        grandTotal.textContent =
            total.toFixed(2);

    }


    // Re-index all purchase item rows
    // before submitting the form.
    //
    // This prevents gaps such as:
    //
    // Items[0]
    // Items[2]
    //
    // and converts them into:
    //
    // Items[0]
    // Items[1]
    function reindexItems() {

        const rows =
            document.querySelectorAll(
                ".purchase-item"
            );


        rows.forEach(function (row, index) {

            const productSelect =
                row.querySelector(
                    ".product-select"
                );

            const quantityInput =
                row.querySelector(
                    ".quantity-input"
                );

            const priceInput =
                row.querySelector(
                    ".price-input"
                );


            productSelect.name =
                `Items[${index}].ProductId`;


            quantityInput.name =
                `Items[${index}].Quantity`;


            priceInput.name =
                `Items[${index}].UnitPrice`;

        });

    }


    // Re-index items immediately before
    // ASP.NET Core receives the form.
    purchaseForm.addEventListener(
        "submit",
        function () {

            reindexItems();

        }
    );


    // Start with one product row
    // when creating a new purchase.
    if (
        document.querySelectorAll(
            ".purchase-item"
        ).length === 0
    ) {

        addItemRow();

    }


    // Calculate initial total.
    updateTotal();

</script>